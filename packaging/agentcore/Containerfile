# The AgentCore Runtime probe (v1.35 step 1, D8): VAREK's image with an HTTP
# server on port 8080 that answers AgentCore Runtime's /ping and
# /invocations, each invocation answered with what the container holds and
# a run of an agent under the Warden. See packaging/agentcore/README.md.
#
# BASE is VAREK's own image built for the same architecture, from the
# repository's root (AgentCore Runtime's default compute takes arm64):
#
#   docker build --platform linux/arm64 -f packaging/container/Containerfile -t varek:arm64 .
#   docker build --platform linux/arm64 --build-arg BASE=varek:arm64 \
#       -f packaging/agentcore/Containerfile -t varek-agentcore-probe:arm64 .
ARG BASE=varek:arm64
FROM ${BASE}
COPY packaging/agentcore/probe_server.py /opt/varek/agentcore_probe.py
EXPOSE 8080
WORKDIR /tmp
ENTRYPOINT ["python3", "/opt/varek/agentcore_probe.py"]
