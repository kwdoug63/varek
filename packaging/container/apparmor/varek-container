# SPDX-License-Identifier: MIT
#
# varek-container: the AppArmor profile for VAREK's container (v1.32, D5 in
# docs/security/v1.32-containers.md). It is Docker's own docker-default
# (github.com/moby/profiles, apparmor/template.go at commit 4b8214f,
# 2026-10-12) with one change: where docker-default denies every mount, this
# allows the three kinds the Warden makes, in a mount namespace of its own:
# that namespace made private, a directory bound, and a bind mount's flags
# changed (the noexec mounts of v1.27.1, warden_noexec.inc.c, and the
# container's cgroup filesystem made read-write, v1.32). No filesystem may
# be mounted, and no filesystem's own options changed.
#
# What it does not do: AppArmor cannot tie a bind's target to its source, nor
# require that a remount keep a flag, so a process holding CAP_SYS_ADMIN in
# the container (the Warden, or a root shell `docker exec` starts with the
# same capabilities) may bind any path onto another and make a bind mount
# read-write. That is the Warden's trust, as on a host; the agent holds no
# capability (its bounding set is empty, so the kernel refuses its mount(2)
# for want of CAP_SYS_ADMIN before AppArmor is asked), and its own filter
# refuses mount(2) besides.
#
# AppArmor 3.0 or later (Ubuntu 22.04, Debian 12, SUSE 15 SP4). On the host,
# as root:
#
#   install -m 644 varek-container /etc/apparmor.d/varek-container
#   apparmor_parser -r -W /etc/apparmor.d/varek-container
#
# and run the container with --security-opt apparmor=varek-container (Docker
# and Podman alike), with the settings in packaging/container/README.md.

abi <abi/3.0>,

#include <tunables/global>

profile varek-container flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  # Disallow obsolete socket families removed from the Linux kernel.
  # AF_DECnet has no AppArmor family name, so it cannot be denied here.
  deny network ax25,
  deny network ipx,
  deny network appletalk,
  deny network netrom,
  deny network rose,
  deny network econet,
  deny network atmsvc,
  deny network irda,
  deny network wanpipe,
  deny network isdn,
  deny network caif,
  # Disallow AF_ALG (Linux kernel crypto API)
  deny network alg,
  # Disallow AF_VSOCK to prevent host/guest communication.
  deny network vsock,
  capability,
  file,
  umount,
  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc and crun may send signals to container processes ("docker stop",
  # "podman stop"), where they run under profiles of their own (Ubuntu 24.04).
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer=varek-container,

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  # The Warden's mounts, in the mount namespace it makes (docker-default has
  # "deny mount," here):
  # 1. that namespace made private, so no mount reaches the container's own
  mount options=(rprivate) -> /,
  # 2. each writable directory the policy names bound onto itself, with the
  #    mounts beneath it
  mount options=(rbind) /** -> /**,
  # 3. a bind mount's flags changed, the others kept: each mount at or under
  #    such a directory remounted noexec, the places that keep exec (v1.29)
  #    remounted without it, and the container's cgroup filesystem (its own
  #    groups only, --cgroupns=private) made read-write (v1.32)
  mount options=(remount, bind) options in (noexec, ro, nosuid, nodev, noatime, nodiratime, relatime, nosymfollow) -> /**,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # allow processes within the container to trace each other (the Warden
  # reads paths from the agent's memory and takes its descriptors with
  # pidfd_getfd), provided all other LSM and yama setting allow it.
  ptrace (trace,tracedby,read,readby) peer=varek-container,
}
