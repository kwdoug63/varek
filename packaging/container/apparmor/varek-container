#
# varek-container: the AppArmor profile for VAREK's container (v1.32, D5 in
# docs/security/v1.32-containers.md). It is Docker's own docker-default (as
# of Docker 29) with one change: where docker-default denies every mount,
# this allows the three the Warden makes for the noexec mounts (v1.27.1,
# warden_noexec.inc.c), in a mount namespace of its own, and no other.
#
# On the host (Ubuntu, Debian, SUSE: any with AppArmor), as root:
#
#   install -m 644 varek-container /etc/apparmor.d/varek-container
#   apparmor_parser -r -W /etc/apparmor.d/varek-container
#
# and run the container with --security-opt apparmor=varek-container (Docker
# and Podman alike), with the settings in packaging/container/README.md.
#
# Only the Warden can make these mounts: the agent's capability bounding set
# is empty, so the kernel refuses the agent's mount(2) for want of
# CAP_SYS_ADMIN before AppArmor is asked.

#include <tunables/global>

profile varek-container flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  # the host and the runtime may signal the container's processes, and they
  # one another
  signal (receive) peer=unconfined,
  signal (send,receive) peer=varek-container,
  # the Warden reads paths from the agent's memory and takes its descriptors
  # (pidfd_getfd)
  ptrace (trace,read,tracedby,readby) peer=varek-container,

  deny @{PROC}/* w,   # write to the files directly in /proc
  # write beneath /proc but in /proc/<pid>/** and /proc/sys/**
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # /proc/sys but /proc/sys/kernel
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # /proc/sys/kernel but shm*
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  # The Warden's mounts, in the mount namespace it makes (docker-default has
  # "deny mount," here):
  # 1. that namespace made private, so no mount reaches the container's own
  mount options=(rprivate) -> /,
  # 2. each writable directory the policy names bound onto itself, with the
  #    mounts beneath it
  mount options=(rbind) /** -> /**,
  # 3. each mount at or under it remounted noexec, its own flags kept; and
  #    the places that keep exec (v1.29) remounted without noexec
  mount options=(remount, bind) options in (noexec, ro, nosuid, nodev, noatime, nodiratime, relatime, nosymfollow) -> /**,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
