# plan_corpus.py: the "named" policy, from the plan's own steps
require warden 1.35
proxy inspect
allow path /usr/ readonly
allow path /lib/ readonly
allow path /lib64/ readonly
allow path /etc/ readonly
allow path /proc/self/ readonly
allow path exact /dev/null
allow path exact /dev/urandom readonly
allow path /tmp/
allow path exact /proc/stat readonly
allow path exact /proc/cpuinfo readonly
allow path exact /proc/meminfo readonly
allow path exact /proc/sys/crypto/fips_enabled readonly
allow path /sys/devices/system/cpu/ readonly
allow path /sys/fs/cgroup/ readonly
allow path /app/ readonly
allow host xray.us-east-1.amazonaws.com:443
allow host logs.us-east-1.amazonaws.com:443
allow host receiptsgateway.gateway.bedrock-agentcore.us-east-1.amazonaws.com:443
allow mcp https://receiptsgateway.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp initialize
allow mcp https://receiptsgateway.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp notifications/initialized
allow mcp https://receiptsgateway.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp tools/list
allow mcp https://receiptsgateway.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp tools/call get-user-profile___get_user_profile
allow mcp https://receiptsgateway.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp tools/call get-recent-expenses___get_recent_expenses
allow mcp https://receiptsgateway.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp tools/call lookup-merchant___lookup_merchant
allow mcp https://receiptsgateway.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp tools/call save-expense___save_expense
allow mcp https://receiptsgateway.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp tools/call human-review___human_review
allow mcp https://receiptsgateway.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp tools/call x_amz_bedrock_agentcore_search
