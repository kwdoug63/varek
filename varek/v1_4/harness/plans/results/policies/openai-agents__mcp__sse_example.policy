# plan_corpus.py: the "named" policy, from the plan's own steps
require warden 1.35
proxy inspect
proxy ports 80 443 8000
allow path /usr/ readonly
allow path /lib/ readonly
allow path /lib64/ readonly
allow path /etc/ readonly
allow path /proc/self/ readonly
allow path exact /dev/null
allow path exact /dev/urandom readonly
allow path /tmp/
allow path exact /proc/stat readonly
allow path exact /proc/cpuinfo readonly
allow path exact /proc/meminfo readonly
allow path exact /proc/sys/crypto/fips_enabled readonly
allow path /sys/devices/system/cpu/ readonly
allow path /sys/fs/cgroup/ readonly
allow path /var/tmp/varek-plan-corpus3/work/openai-agents__mcp__sse_example/ readonly
allow path /var/tmp/lg/venv/ readonly
allow host api.openai.com:443
allow host 127.0.0.1:8000
