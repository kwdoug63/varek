{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.40.0.0",
  "metadata": {
    "description": "VAREK for Microsoft Sentinel (v1.40, docs/security/v1.39-security-operations.md, section 3): the table VarekOCSF_CL in the Sentinel workspace, the data collection rule varek export --format sentinel sends to through the Logs Ingestion API, and, given a principal, its right to send."
  },
  "parameters": {
    "workspaceName": {
      "type": "string",
      "metadata": {
        "description": "The Log Analytics workspace Microsoft Sentinel is on, in this resource group."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "The workspace's region."
      }
    },
    "dataCollectionRuleName": {
      "type": "string",
      "defaultValue": "varek-ocsf",
      "metadata": {
        "description": "The data collection rule's name."
      }
    },
    "retentionInDays": {
      "type": "int",
      "defaultValue": 90,
      "minValue": 4,
      "maxValue": 730,
      "metadata": {
        "description": "How long the table keeps rows (interactive)."
      }
    },
    "principalId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The object id of the service principal or managed identity the export authenticates as; given, it gets Monitoring Metrics Publisher on the rule. Empty: assign it yourself."
      }
    }
  },
  "variables": {
    "workspaceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
    "dcrId": "[resourceId('Microsoft.Insights/dataCollectionRules', parameters('dataCollectionRuleName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/tables",
      "apiVersion": "2022-10-01",
      "name": "[concat(parameters('workspaceName'), '/VarekOCSF_CL')]",
      "properties": {
        "plan": "Analytics",
        "retentionInDays": "[parameters('retentionInDays')]",
        "schema": {
          "name": "VarekOCSF_CL",
          "description": "The VAREK Warden's decisions, as OCSF 1.9.0 events (varek export --format sentinel).",
          "columns": [
            {
              "name": "TimeGenerated",
              "type": "datetime",
              "description": "the decision's time"
            },
            {
              "name": "EventName",
              "type": "string",
              "description": "varek.decision, varek.run_start, varek.audit, ..."
            },
            {
              "name": "Decision",
              "type": "string",
              "description": "ALLOW or DENY"
            },
            {
              "name": "Verdict",
              "type": "string",
              "description": "SATISFIED, UNSATISFIED or UNKNOWN"
            },
            {
              "name": "Rule",
              "type": "string",
              "description": "the rule that decided"
            },
            {
              "name": "PolicyLine",
              "type": "int",
              "description": "the policy line that decided"
            },
            {
              "name": "PolicyText",
              "type": "string",
              "description": "that line's text"
            },
            {
              "name": "PolicyName",
              "type": "string",
              "description": "the policy's file"
            },
            {
              "name": "PolicySha256",
              "type": "string",
              "description": "the policy's SHA-256"
            },
            {
              "name": "Mode",
              "type": "string",
              "description": "dry_run for what a dry run let through"
            },
            {
              "name": "Target",
              "type": "string",
              "description": "what the decision was about: a file, a process, an endpoint, an MCP call"
            },
            {
              "name": "ClassUid",
              "type": "int",
              "description": "the OCSF class"
            },
            {
              "name": "ClassName",
              "type": "string",
              "description": "the OCSF class's name"
            },
            {
              "name": "ActivityName",
              "type": "string",
              "description": "the OCSF activity"
            },
            {
              "name": "Action",
              "type": "string",
              "description": "OCSF's action: Allowed or Denied"
            },
            {
              "name": "Disposition",
              "type": "string",
              "description": "OCSF's disposition: Allowed, Blocked, Detected"
            },
            {
              "name": "Status",
              "type": "string",
              "description": "OCSF's status"
            },
            {
              "name": "SeverityId",
              "type": "int",
              "description": "OCSF's severity id"
            },
            {
              "name": "Severity",
              "type": "string",
              "description": "OCSF's severity"
            },
            {
              "name": "RunId",
              "type": "string",
              "description": "the run"
            },
            {
              "name": "ReportId",
              "type": "string",
              "description": "the record in the run's verdict stream"
            },
            {
              "name": "Seq",
              "type": "long",
              "description": "the record's sequence number"
            },
            {
              "name": "Agent",
              "type": "string",
              "description": "the agent or sub-agent"
            },
            {
              "name": "AgentType",
              "type": "string",
              "description": "its type"
            },
            {
              "name": "Computer",
              "type": "string",
              "description": "the host the run was on"
            },
            {
              "name": "ProcessId",
              "type": "int",
              "description": "the process"
            },
            {
              "name": "UserId",
              "type": "string",
              "description": "the user"
            },
            {
              "name": "WardenVersion",
              "type": "string",
              "description": "the Warden's version"
            },
            {
              "name": "AuditPassed",
              "type": "boolean",
              "description": "an audit event's result"
            },
            {
              "name": "OcsfEvent",
              "type": "dynamic",
              "description": "the whole OCSF 1.9.0 event"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2023-03-11",
      "name": "[parameters('dataCollectionRuleName')]",
      "location": "[parameters('location')]",
      "kind": "Direct",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('workspaceName'), 'VarekOCSF_CL')]"
      ],
      "properties": {
        "description": "VAREK: OCSF events from varek export --format sentinel, into VarekOCSF_CL.",
        "streamDeclarations": {
          "Custom-VarekOCSF": {
            "columns": [
              {
                "name": "TimeGenerated",
                "type": "datetime"
              },
              {
                "name": "EventName",
                "type": "string"
              },
              {
                "name": "Decision",
                "type": "string"
              },
              {
                "name": "Verdict",
                "type": "string"
              },
              {
                "name": "Rule",
                "type": "string"
              },
              {
                "name": "PolicyLine",
                "type": "int"
              },
              {
                "name": "PolicyText",
                "type": "string"
              },
              {
                "name": "PolicyName",
                "type": "string"
              },
              {
                "name": "PolicySha256",
                "type": "string"
              },
              {
                "name": "Mode",
                "type": "string"
              },
              {
                "name": "Target",
                "type": "string"
              },
              {
                "name": "ClassUid",
                "type": "int"
              },
              {
                "name": "ClassName",
                "type": "string"
              },
              {
                "name": "ActivityName",
                "type": "string"
              },
              {
                "name": "Action",
                "type": "string"
              },
              {
                "name": "Disposition",
                "type": "string"
              },
              {
                "name": "Status",
                "type": "string"
              },
              {
                "name": "SeverityId",
                "type": "int"
              },
              {
                "name": "Severity",
                "type": "string"
              },
              {
                "name": "RunId",
                "type": "string"
              },
              {
                "name": "ReportId",
                "type": "string"
              },
              {
                "name": "Seq",
                "type": "long"
              },
              {
                "name": "Agent",
                "type": "string"
              },
              {
                "name": "AgentType",
                "type": "string"
              },
              {
                "name": "Computer",
                "type": "string"
              },
              {
                "name": "ProcessId",
                "type": "int"
              },
              {
                "name": "UserId",
                "type": "string"
              },
              {
                "name": "WardenVersion",
                "type": "string"
              },
              {
                "name": "AuditPassed",
                "type": "boolean"
              },
              {
                "name": "OcsfEvent",
                "type": "dynamic"
              }
            ]
          }
        },
        "destinations": {
          "logAnalytics": [
            {
              "workspaceResourceId": "[variables('workspaceId')]",
              "name": "sentinel"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [
              "Custom-VarekOCSF"
            ],
            "destinations": [
              "sentinel"
            ],
            "transformKql": "source",
            "outputStream": "Custom-VarekOCSF_CL"
          }
        ]
      }
    },
    {
      "condition": "[not(empty(parameters('principalId')))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[format('Microsoft.Insights/dataCollectionRules/{0}', parameters('dataCollectionRuleName'))]",
      "name": "[guid(variables('dcrId'), parameters('principalId'), '3913510d-42f4-4e42-8a64-420c390055eb')]",
      "dependsOn": [
        "[variables('dcrId')]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '3913510d-42f4-4e42-8a64-420c390055eb')]",
        "principalId": "[parameters('principalId')]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "logsIngestionEndpoint": {
      "type": "string",
      "value": "[reference(variables('dcrId'), '2023-03-11').endpoints.logsIngestion]"
    },
    "dataCollectionRuleImmutableId": {
      "type": "string",
      "value": "[reference(variables('dcrId'), '2023-03-11').immutableId]"
    }
  }
}
