def cmd_bench_baseline(args, cfg):
    """v1.29: `varek bench --baseline`: what the baseline and each profile
    cost a decision, against a sector pack. Each is the policy `varek run`
    writes (for the bench's user, in a working directory of its own), all
    under `require warden 1.29`, the bench's rules last: every bench call is
    decided after every rule of the base."""
    import pwd
    import tempfile
    try:
        pw = pwd.getpwnam(args.run_as or (cfg["run_as"] if cfg else "nobody"))
    except KeyError:
        raise CliError("--run-as: no such user")
    packs = builtin_packs()
    pack = args.pack or "healthcare"
    if pack not in packs:
        raise CliError(f"no built-in pack {pack!r}", fix="`varek policy list` shows them")
    with open(packs[pack], encoding="utf-8") as fh:
        ptext = fh.read()
    ptext = re.sub(r"(?m)^require warden \S+\s*$", "", ptext)
    bases = {f"pack {pack}": "require warden 1.29\n" + ptext}
    proj = tempfile.mkdtemp(prefix="varek-bench-proj-")
    os.chmod(proj, 0o755)
    try:
        tmp = f"/tmp/varek-{pw.pw_uid}"
        bases["baseline"] = varek_baseline.generate(proj, pw, tmp, None)
        for name, prof in sorted(varek_baseline.all_profiles(varek_home()).items()):
            bases[f"baseline + {name}"] = varek_baseline.generate(proj, pw, tmp, prof)
        res = _bench_bases(args, cfg, bases, "baseline")
    finally:
        shutil.rmtree(proj, ignore_errors=True)
    if args.json:
        print(json.dumps(res, indent=2))
        return 0 if res["ok"] else 1
    _bench_head("baseline", res)
    cols = [k for k, _ in varek_bench.KINDS]
    short = {"open_allowed": "open ok", "open_denied": "open deny", "open_unknown": "open none",
             "connect_allowed": "conn ok", "connect_denied": "conn deny", "request": "request"}
    print("the Warden's own time per decision (p50, us), by base policy:")
    print(f"{'base':22} {'rules':>5} " + " ".join(f"{short.get(k, k[:9]):>9}" for k in cols))
    for m, b in res["bases"].items():
        print(f"{m:22} {b['rules']:>5} " +
              " ".join(f"{_fmt_us(res['kinds'][k][m]['decision_p50_us']):>9}" for k in cols))
    print()
    print("each base: require warden 1.29 (opened as the agent), then the bench's own rules. The pack's own "
          "require line is replaced. rules: the base's allow and deny lines.")
    print("checks: " + ("every run's outcomes as expected" if res["ok"] else "SOME CHECKS FAILED (run with --json)"))
    return 0 if res["ok"] else 1


def cmd_bench_for(args, cfg):
    """v1.31: `varek bench --for`: what deciding a call as a confined subject
    (an MCP server, D3) costs, against deciding it as the agent. The bench's
    calls are made by a copy of the workload the agent launches: as the
    agent, after the baseline's rules; as a server declared by an `mcp
    server` line, whose rules are the bench's only (the baseline is the
    agent's); and as a server with its own copy of the baseline (as `varek
    run --mcp` writes it). All under `require warden 1.31`."""
    import pwd
    import tempfile
    try:
        pw = pwd.getpwnam(args.run_as or (cfg["run_as"] if cfg else "nobody"))
    except KeyError:
        raise CliError("--run-as: no such user")
    proj = tempfile.mkdtemp(prefix="varek-bench-proj-")
    os.chmod(proj, 0o755)
    try:
        base = re.sub(r"(?m)^require warden \S+\s*$", "require warden 1.31",
                      varek_baseline.generate(proj, pw, f"/tmp/varek-{pw.pw_uid}", None), count=1)
        own = base + "\n" + "\n".join(varek_baseline.server_rules(varek_bench.SERVER_NAME, proj)) + "\n"
        bases = {"agent": base, "server": base, "server + own": own}
        res = _bench_bases(args, cfg, bases, "for",
                           subjects={"agent": "agent", "server": "server", "server + own": "server"})
    finally:
        shutil.rmtree(proj, ignore_errors=True)
    sname = varek_bench.SERVER_NAME
    for m, text in bases.items():
        mine = [ln for ln in text.splitlines() if re.match(r"\s*(allow|deny)\b", ln)]
        srv = sum(1 for ln in mine if re.search(rf"\sfor={sname}\b", ln.split("#", 1)[0]))
        bench = len(varek_bench.bench_rules("/x", {"allowed": 1, "denied": 2, "request": 3}))
        res["bases"][m]["decided_against"] = (srv if m != "agent" else len(mine) - srv) + bench
    if args.output:
        try:
            with open(args.output, "w") as fh:
                json.dump(res, fh, indent=2)
                fh.write("\n")
        except OSError as e:
            warn(f"could not write {args.output}: {e}")
    if args.json:
        print(json.dumps(res, indent=2))
        return 0 if res["ok"] else 1
    _bench_head("for", res)
    cols = [k for k, _ in varek_bench.KINDS]
    short = {"open_allowed": "open ok", "open_denied": "open deny", "open_unknown": "open none",
             "connect_allowed": "conn ok", "connect_denied": "conn deny", "request": "request"}
    print("the Warden's own time per decision (p50, us), by who makes the calls:")
    print(f"{'calls made by':22} {'rules':>5} " + " ".join(f"{short.get(k, k[:9]):>9}" for k in cols))
    for m, b in res["bases"].items():
        print(f"{m:22} {b['decided_against']:>5} " +
              " ".join(f"{_fmt_us(res['kinds'][k][m]['decision_p50_us']):>9}" for k in cols))
    print()
    print(f"agent: the calls are the agent's, after the baseline's rules. server: the agent launches an MCP "
          f"server (mcp server {sname}), which makes them; its rules are the bench's only (for={sname}). "
          f"server + own: it also has its own copy of the baseline, as varek run --mcp writes it. rules: "
          f"the rules each call is decided against (the subject's own, the bench's included).")
    print("checks: " + ("every run's outcomes as expected, each call decided as its subject"
                        if res["ok"] else "SOME CHECKS FAILED (run with --json)"))
    return 0 if res["ok"] else 1


def _fmt_us(v):
    return "-" if v is None else (f"{v:.0f}" if v >= 10 else f"{v:.1f}")


def cmd_bench(args):
    need_root("bench")
    cfg = load_config(required=False)
    if getattr(args, "subagents", False):                                          # v1.28.1
        return cmd_bench_subagents(args, cfg)
    if getattr(args, "open_as", False):                                            # v1.29
        return cmd_bench_open_as(args, cfg)
    if getattr(args, "baseline", False):
        return cmd_bench_baseline(args, cfg)
    if getattr(args, "for_", False):                                               # v1.31
        return cmd_bench_for(args, cfg)
    if getattr(args, "mcp", False):
        return cmd_bench_mcp(args, cfg)
    if args.proxy:
        return cmd_bench_proxy(args, cfg)
    if args.launches:
        return cmd_bench_launch(args, cfg)
    args.n = 2000 if args.n is None else args.n
    args.warmup = 200 if args.warmup is None else args.warmup
    args.rounds = 5 if args.rounds is None else args.rounds
    if args.bare and args.policy:
        raise CliError("--bare and --policy cannot be combined",
                       fix="--bare measures the bench's own rules only; --policy adds a policy's rules")
    base, label = None, None
    if args.policy:
        base = resolve_pack(args.policy, cfg)
        require_entitlement(base)
    elif not args.bare and cfg and os.path.isfile(cfg["policy"]):
        base = cfg["policy"]
        label = f"active policy {base}"
    if base and not label:
        label = os.path.basename(base)
        if label.endswith(".policy.txt"):
            label = label[:-len(".policy.txt")]
    run_as = args.run_as or (cfg["run_as"] if cfg else "nobody")
    sign_key = None
    if cfg and cfg["sign_key"] and not args.no_sign:
        sign_key = cfg["sign_key"]
    if args.output and not os.access(os.path.dirname(os.path.abspath(args.output)), os.W_OK):
        raise CliError(f"cannot write {args.output}", fix="give -o a path in a writable directory")
    if args.n < 100 or args.rounds < 1 or args.warmup < 0:
        raise CliError("use -n of at least 100, --rounds of at least 1 and --warmup of 0 or more")
    if SHOW_COMMANDS:
        print(_paint("2", f"$ {warden_bin()} <bench policy> --run-as {run_as} -- "
                          f"{tool('bench_workload')} run ...  (and natively, as {run_as})"),
              file=sys.stderr)
    progress = (lambda m: None) if args.json else (
        lambda m: print(_paint("2", f"[varek] bench {m}"), file=sys.stderr))
    try:
        res = varek_bench.run(warden_bin(), tool("bench_workload"), base_policy=base,
                              base_label=label, n=args.n, warmup=args.warmup,
                              rounds=args.rounds, run_as=run_as, sign_key=sign_key,
                              progress=progress, keep=args.keep)
    except varek_bench.BenchError as e:
        raise CliError(str(e), fix=e.fix)
    res["varek_command"] = CLI_VERSION
    budget_fail = []
    if args.max_added_p50 is not None:
        budget_fail = [k for k, r in res["kinds"].items() if r["added_p50_us"] > args.max_added_p50]
        res["budget"] = {"max_added_p50_us": args.max_added_p50, "over": budget_fail}
    if args.output:
        try:
            with open(args.output, "w") as fh:
                json.dump(res, fh, indent=2)
                fh.write("\n")
        except OSError as e:
            warn(f"could not write {args.output}: {e}")
            args.output = None
    if args.json:
        print(json.dumps(res, indent=2))
    else:
        sys.stdout.write(varek_bench.format_report(res, CLI_VERSION))
        if budget_fail:
            fail(f"added p50 over {args.max_added_p50} us: " + ", ".join(budget_fail))
        if args.output:
            ok(f"results written to {args.output}")
        if res.get("kept"):
            info(f"  kept: the bench's files in {res['kept'][0]}; its policy and verdict "
                 f"streams in {res['kept'][1]}")
    return 0 if res["ok"] and not budget_fail else 1


def cmd_version(args):
    w = "not built"
    try:
        with open(warden_bin(), "rb") as fh:
            m = re.search(rb'"warden":"(\d+\.\d+\.\d+)"', fh.read())
        if m:
            w = m.group(1).decode()
        else:
            with open(warden_bin(), "rb") as fh:
                m = re.search(rb"(1\.\d+\.\d+)", fh.read())
            w = m.group(1).decode() if m else "unknown"
    except OSError:
        pass
    info(f"varek command {CLI_VERSION}")
    info(f"VAREK Warden  {w}  ({varek_home()})")
    return 0


# -------------------------------------------------------------------- main --

EPILOG = """\
Getting started:
  sudo varek doctor                       is this host ready?
  sudo varek init --pack healthcare       settings, signing key, log directory
  sudo varek preflight --run              a real trial run, then its audit
  sudo varek run -- python3 agent.py      supervise an agent
  varek refusals                          what was refused in the last run, and why
  varek audit                             re-check the last run's verdicts and signatures
  sudo varek export                       signed CycloneDX 1.6 evidence for auditors
  sudo varek bench                        what mediation costs per call on this host

Add --show-commands to any command to print the underlying tool calls.
"""


def build_parser():
    p = argparse.ArgumentParser(
        prog="varek",
        description="Run AI agents under the VAREK Warden and check what it decided.",
        epilog=EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--show-commands", action="store_true",
                   help="print each underlying command before running it")
    sub = p.add_subparsers(dest="cmd", metavar="<command>")

    def add(name, fn, help_, **kw):
        sp = sub.add_parser(name, help=help_, description=help_, **kw)
        sp.set_defaults(fn=fn)
        return sp

    add("doctor", cmd_doctor, "check that this host can run the Warden")

    sp = add("init", cmd_init, "set up settings, signing key and log directory (root)")
    sp.add_argument("--pack", help="policy pack name (see `varek policy list`) or a policy file")
    sp.add_argument("--log-dir", help=f"where verdict streams go (default {DEFAULT_LOG_DIR})")
    sp.add_argument("--run-as", help="unprivileged user the agent runs as (default nobody)")
    sp.add_argument("--anchor", help="anchor path, e.g. /run/varek/anchor.fifo for an off-host anchor")
    sp.add_argument("--spool", help="the anchor forwarder's spool directory")
    sp.add_argument("--no-sign", action="store_true", help="do not create a signing key")
    sp.add_argument("--force", action="store_true", help="overwrite existing settings")
    sp.add_argument("--force-key", action="store_true", help="replace an existing signing key")

    pol = sub.add_parser("policy", help="list, inspect, check and switch policies",
                         description="List, inspect, check and switch policies.")
    psub = pol.add_subparsers(dest="pcmd", metavar="<action>")
    pol.set_defaults(fn=lambda a: (pol.print_help(), 0)[1])
    x = psub.add_parser("list", help="show the policy packs available")
    x.set_defaults(fn=cmd_policy_list)
    x = psub.add_parser("show", help="summarize a policy (default: the active one)")
    x.add_argument("file", nargs="?")
    x.set_defaults(fn=cmd_policy_show)
    x = psub.add_parser("check", help="lint a policy: rules that never fire, syntax errors")
    x.add_argument("file", nargs="?")
    x.add_argument("--explain", action="store_true",
                   help="also show, for each rule, an example it decides")
    x.set_defaults(fn=cmd_policy_check)
    x = psub.add_parser("suggest", help="v1.29: draft a policy from a run's refusals (a dry run's, or an "
                                         "enforcing run's); installs nothing")
    x.add_argument("log", nargs="?", help="a verdict log (default: the last run)")
    x.add_argument("-o", "--output", help="write the draft here instead of to stdout")
    x.add_argument("--force", action="store_true", help="overwrite --output if it exists")
    x.add_argument("--for", dest="for_", metavar="NAME", help="v1.31: rules for this MCP server (or confined "
                   "sub-agent), from its refusals, each written for=NAME")
    x.set_defaults(fn=cmd_policy_suggest)
    x = psub.add_parser("use", help="make a pack or file the active policy (root)")
    x.add_argument("pack")
    x.set_defaults(fn=cmd_policy_use)
    x = psub.add_parser("add", help="install a licensed policy pack file (root)")
    x.add_argument("file")
    x.add_argument("--name", help="name to install it under")
    x.set_defaults(fn=cmd_policy_add)

    sp = add("preflight", cmd_preflight, "check the deployment before running agents")
    sp.add_argument("--run", action="store_true", help="also do a real trial run and audit it (root)")

    sp = add("run", cmd_run, "run an agent under the Warden (root)",
             usage="varek run [options] -- <agent command> [args...]")
    sp.add_argument("--policy", help="use this pack or file instead of the active policy")
    sp.add_argument("--baseline", action="store_true",
                    help="v1.29: use the baseline policy for this directory even with settings "
                         "(the default when there are none)")
    sp.add_argument("--profile", metavar="NAME|FILE|none",
                    help="v1.29: the agent profile the baseline adds (default: chosen by the command's name)")
    sp.add_argument("--env", action="append", metavar="NAME",
                    help="v1.29: pass this variable to the agent (repeatable; recorded by name only). "
                         "With the baseline the agent gets a clean environment otherwise")
    sp.add_argument("--show-policy", action="store_true",
                    help="v1.29: print the baseline policy this run would use, and stop")
    sp.add_argument("--dry-run", action="store_true",
                    help="v1.29: NOT ENFORCING: decide and record every call, and let through what the policy "
                         "refuses (the Warden's own files, the hard-denied calls and revocation still refuse)")
    sp.add_argument("--writable-exec", action="store_true",
                    help="let the agent launch files in the directories it may write (the Warden's "
                         "--writable-exec; recorded)")
    sp.add_argument("--mcp", action="append", metavar="NAME=PATH", default=[],
                    help="v1.31, with the baseline: run the MCP server at PATH (when the agent launches it) "
                         "confined as NAME, decided by rules of its own: the system read-only and the working "
                         "directory read-only; pinned to the file's SHA-256 (repeat for more servers)")
    sp.add_argument("--plan", help="check this action-graph plan before the agent starts")
    sp.add_argument("--run-as", help="unprivileged user for the agent (default from settings; with the "
                                     "baseline, the user who ran sudo)")
    sp.add_argument("--log", help="write the verdict stream here instead of a new file")
    sp.add_argument("--stderr-lines", type=int, default=20, metavar="N",
                    help="after the run, show the last N lines the agent wrote to stderr "
                         "(the Warden keeps them in the verdict stream; default 20)")
    sp.add_argument("command", nargs=argparse.REMAINDER)

    add("status", cmd_status, "show settings and the last run")

    sp = add("runs", cmd_runs, "list recent runs")
    sp.add_argument("-n", type=int, default=10, help="how many (default 10)")

    sp = add("revoke", cmd_revoke, "revoke a running run: every later call is refused (root)",
             epilog="The Warden records `revoked`, refuses every later file open, connect and request, "
                    "the egress proxy clears every credential value it holds, and warden-secrets "
                    "revokes the run's Vault leases. What was already sent stays sent; the run goes "
                    "on, held to refusals, and ends as it would.")
    sp.add_argument("run", nargs="?", help="the run id (or a running run's verdict log)")
    sp.add_argument("--all", action="store_true", help="revoke every running run")

    sp = add("refusals", cmd_refusals, "list the actions refused in a run, and why")
    sp.add_argument("log", nargs="?", help="a verdict log (default: the last run)")
    sp.add_argument("-n", type=int, default=25, help="how many to show (default 25)")
    sp.add_argument("--subagent", metavar="NAME", help="only the calls made for this sub-agent (v1.28.1)")
    sp.add_argument("--for", dest="for_", metavar="NAME", help="only the calls made for this MCP server or "
                    "confined sub-agent (v1.31; the same as --subagent)")
    sp.add_argument("--user", metavar="SUB", help="only if the run was on behalf of this user (v1.28.1)")
    g = sp.add_mutually_exclusive_group()
    g.add_argument("--enforced", action="store_true", help="only the calls refused (in a dry run, v1.29)")
    g.add_argument("--not-enforced", action="store_true",
                   help="only the calls a dry run let through that the policy refuses (v1.29)")

    sp = add("audit", cmd_audit, "re-check a run's certificates, chain and signatures")
    sp.add_argument("log", nargs="?", help="a verdict log (default: the last run)")
    sp.add_argument("--allow-incomplete", action="store_true",
                    help="audit a run that has no run_end yet")

    sp = add("export", cmd_export, "write CycloneDX 1.6 authorization evidence, or OCSF 1.9.0 events, for a run")
    sp.add_argument("log", nargs="?", help="a verdict log (default: the last run)")
    sp.add_argument("--format", choices=("cyclonedx", "ocsf"), default="cyclonedx",
                    help="cyclonedx (default) or ocsf: OCSF 1.9.0 events, one per line (v1.31)")
    sp.add_argument("--follow", metavar="STREAM", help="ocsf: tail a live run's stream, writing each event "
                    "as its record is chained (to stdout, or -o)")
    sp.add_argument("--policy", help="ocsf: the policy file the run used (default: found from the log)")
    sp.add_argument("--idle", type=float, default=0, metavar="SECONDS",
                    help="ocsf --follow: end, with a failed verdict, after this long with no new record "
                         "(default: wait for the run's end)")
    sp.add_argument("-o", "--output", help="output file (default: next to the log, .cdx.json or .ocsf.jsonl)")
    sp.add_argument("--agent", default="agent", help="name of the agent, for the evidence")
    sp.add_argument("--no-sign", action="store_true", help="do not sign the evidence")
    sp.add_argument("--allow-incomplete", action="store_true",
                    help="export a run that has no run_end yet")
    sp.add_argument("--verify", metavar="FILE", help="verify a signed evidence file instead (ocsf: check "
                    "events against the log they were exported from)")
    sp.add_argument("--pubkey", help="public key to verify with (default from settings)")

    sp = add("bench", cmd_bench, "measure what the Warden adds per call on this host (root)",
             epilog="Runs a fixed workload natively and under the Warden, alternating, and "
                    "reports per-call times, the time the Warden adds and its own decision "
                    "time, and checks every verdict. Uses the active policy's rules plus the "
                    "bench's own (or only the bench's own with --bare). Exit 1 if a check "
                    "fails or --max-added-p50 is exceeded. With --proxy: HTTPS requests "
                    "natively, through the egress proxy in SNI mode and in inspecting mode.")
    sp.add_argument("--proxy", action="store_true",
                    help="measure the egress proxy instead: HTTPS requests natively, in SNI mode and "
                         "in inspecting mode (defaults -n 200 --warmup 20 --rounds 3)")
    sp.add_argument("--subagents", action="store_true",
                    help="v1.28.1: what attributing each call to its control group costs (sub-agents named or not)")
    sp.add_argument("--open-as", action="store_true",
                    help="v1.29: what opening files as the agent costs (require warden 1.28 and 1.29)")
    sp.add_argument("--baseline", action="store_true",
                    help="v1.29: the decision time under the baseline and each profile, against a pack")
    sp.add_argument("--pack", metavar="NAME", help="with --baseline: the pack to compare with (default healthcare)")
    sp.add_argument("--for", dest="for_", action="store_true",
                    help="v1.31: the decision time of a confined MCP server's calls against the agent's")
    sp.add_argument("--mcp", action="store_true",
                    help="v1.31: MCP calls over HTTPS of 1 KiB to 1 MiB, natively, under a request rule and "
                         "decided as MCP calls (defaults -n 100 --warmup 10 --rounds 3)")
    sp.add_argument("--launches", action="store_true",
                    help="measure decided program launches instead (v1.27): launches and an open "
                         "natively, with launches off and on (defaults -n 200 --warmup 20 --rounds 3)")
    sp.add_argument("--policy", help="measure with this pack or policy file's rules instead of the active policy")
    sp.add_argument("--bare", action="store_true", help="the bench's own rules only, no policy")
    sp.add_argument("-n", type=int, default=None,
                    help="timed calls of each kind per run (default 2000)")
    sp.add_argument("--warmup", type=int, default=None, help="untimed calls of each kind first (default 200)")
    sp.add_argument("--rounds", type=int, default=None,
                    help="native and Warden runs, alternating (default 5 of each)")
    sp.add_argument("--run-as", help="user the workload runs as (default from settings, or nobody)")
    sp.add_argument("--no-sign", action="store_true", help="do not sign the bench's verdict streams")
    sp.add_argument("--max-added-p50", type=float, metavar="US",
                    help="exit 1 if any kind of call adds more than US microseconds at p50 (for CI)")
    sp.add_argument("-o", "--output", help="also write the full results as JSON to this file")
    sp.add_argument("--json", action="store_true", help="print the results as JSON instead of the report")
    sp.add_argument("--keep", action="store_true",
                    help="keep the bench's files, policy and verdict streams (printed at the end)")

    add("license", cmd_license, "check the VAREK Enterprise subscription (AWS Marketplace)")
    add("version", cmd_version, "show the varek command and Warden versions")
    return p


def main(argv=None):
    global SHOW_COMMANDS
    p = build_parser()
    args = p.parse_args(argv)
    SHOW_COMMANDS = args.show_commands
    if not getattr(args, "fn", None):
        p.print_help()
        return 0
    try:
        return args.fn(args) or 0
    except CliError as e:
        print(f"varek: {e}", file=sys.stderr)
        if e.fix:
            print(f"  fix: {e.fix}", file=sys.stderr)
        return e.code if isinstance(e.code, int) else 2
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
