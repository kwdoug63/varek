def baseline_for_run(args, cmd, make):
    """v1.29: the baseline for this run: (policy text, passwd entry, --run-as
    value, the temporary directory, the profile's name, notes)"""
    try:
        pw, ra, why_user = varek_baseline.agent_user(args.run_as)
        if pw is None:
            raise CliError(f"--run-as {ra}: no such user (the baseline needs a passwd entry for its home)")
        if pw.pw_uid == 0:
            raise CliError("the agent would run as root",
                           fix="run it with sudo as yourself, or pass --run-as USER")
        profiles = varek_baseline.all_profiles(varek_home())
        prof, why_prof = varek_baseline.choose_profile(cmd, profiles, args.profile)
        cwd = varek_baseline.check_cwd(os.getcwd(), pw.pw_dir)
        tmp = varek_baseline.tmp_dir(pw, make=make)
        path = varek_baseline.agent_path(cmd, os.environ)
        servers = varek_baseline.mcp_servers(getattr(args, "mcp", None) or [], cwd, tmp)       # v1.31
        text = varek_baseline.generate(cwd, pw, tmp, prof, path=path, servers=servers)
    except varek_baseline.BaselineError as e:
        raise CliError(str(e))
    notes = [f"the agent runs as {pw.pw_name} ({why_user})",
             f"profile {prof['name']} ({why_prof})" if prof else f"no profile ({why_prof}): the baseline alone"]
    return text, pw, ra, tmp, (prof["name"] if prof else None), notes, path


def cmd_run(args):
    cmd = args.command
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    if not cmd:
        raise CliError("no agent command given",
                       fix="put it after --, e.g. `sudo varek run -- python3 agent.py`")
    cfg = load_config(required=False)
    baseline = args.baseline or (cfg is None and not args.policy)
    if args.policy and args.baseline:
        raise CliError("--policy and --baseline together", fix="choose one")
    if args.mcp and not baseline:                                                  # v1.31
        raise CliError("--mcp goes with the baseline policy (write `mcp server` lines in your own policy)",
                       fix="run with no configuration, or pass --baseline")
    if args.mcp and args.dry_run:
        raise CliError("--mcp with --dry-run is refused: a dry run does not run sub-agents",
                       fix="dry-run the agent without --mcp, then run with it")
    if (args.profile or args.env) and not baseline:
        raise CliError("--profile and --env go with the baseline policy",
                       fix="run with no configuration, or pass --baseline")
    if args.show_policy:
        if not baseline:
            raise CliError("--show-policy prints the baseline policy", fix="pass --baseline")
        text, _, _, _, _, notes, _ = baseline_for_run(args, cmd, make=False)
        sys.stdout.write(text)
        for n in notes:
            print(_paint("2", f"[varek] {n}"), file=sys.stderr)
        return 0
    need_root("run")
    if cfg is None:
        cfg = default_config()
        first_use(cfg)
    env = None
    if baseline:
        text, pw, run_as, tmp, prof, notes, path = baseline_for_run(args, cmd, make=True)
        try:
            policy = varek_baseline.store(text)
            env = varek_baseline.agent_env(pw, tmp, args.env or [], os.environ, path)
        except (varek_baseline.BaselineError, OSError) as e:
            raise CliError(str(e))
        label = f"the baseline policy for {os.getcwd()}" + (f", profile {prof}" if prof else "")
        for n in notes:
            print(_paint("2", f"[varek] {n}"), file=sys.stderr)
        print(_paint("2", f"[varek] policy {policy} (`varek run --baseline --show-policy -- ...` prints it)"),
              file=sys.stderr)
    else:
        policy = resolve_pack(args.policy, cfg) if args.policy else cfg["policy"]
        if args.policy:
            require_entitlement(policy)
        run_as = args.run_as or cfg["run_as"] or "nobody"
        label = pack_summary(policy) or os.path.basename(policy)
    os.makedirs(cfg["log_dir"], exist_ok=True)
    stamp = _dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    log = args.log or os.path.join(cfg["log_dir"], f"verdicts-{stamp}.log")
    n = 1
    while os.path.exists(log) and not args.log:
        log = os.path.join(cfg["log_dir"], f"verdicts-{stamp}-{n}.log")
        n += 1

    argv = [warden_bin(), policy]
    if args.plan:
        argv += ["--plan", args.plan]
    if cfg["sign_key"]:
        argv += ["--sign-key", cfg["sign_key"]]
    if cfg["anchor"]:
        argv += ["--anchor", cfg["anchor"]]
    if args.writable_exec:
        argv += ["--writable-exec"]
    if args.dry_run:                                                  # v1.29
        if args.plan:
            raise CliError("--dry-run with --plan is refused",
                           fix="check a plan with `varek policy check`; dry-run the agent without --plan")
        argv += ["--dry-run"]
    argv += ["--run-as", run_as, "--"] + cmd

    fd = os.open(log, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o640)
    if args.dry_run:
        print(_paint("1;33", "[varek] DRY RUN: NOT ENFORCING. Every call is decided and recorded; what the "
                             "policy refuses is let through."), file=sys.stderr)
    print(_paint("2", f"[varek] supervising `{' '.join(cmd)}` under {label}; "
                      f"verdicts -> {log}"), file=sys.stderr)
    with os.fdopen(fd, "w") as err:
        r = run_cmd(argv, check=False, stderr=err, env=env)

    agent_err = []
    with open(log, encoding="utf-8", errors="replace") as fh:
        agent_err = [ln[len("[agent] "):].rstrip("\n") for ln in fh if ln.startswith("[agent] ")]
    if agent_err:
        print(_paint("2", f"[varek] the agent's stderr ({len(agent_err)} line(s), kept in the log):"),
              file=sys.stderr)
        for ln in agent_err[-args.stderr_lines:]:
            print("  " + ln, file=sys.stderr)
    s = summarize(read_records(log))
    print(_paint("2", f"[varek] run {s['run'] or '?'} ended (exit {r.returncode}): "
                      f"{s['allowed']} allowed, {s['refused']} refused "
                      f"({s['unknown']} UNKNOWN)"), file=sys.stderr)
    if s["dry"] or args.dry_run:
        print(_paint("1;33", f"[varek] DRY RUN: NOT ENFORCING: {s['not_enforced']} call(s) the policy refuses "
                             f"were let through; `varek refusals` lists them, and `varek policy suggest` "
                             f"drafts rules for them"), file=sys.stderr)
    elif s["refused"]:
        print(_paint("2", "[varek] see why with `varek refusals`"), file=sys.stderr)
    if s["run"] is None:
        with open(log, encoding="utf-8", errors="replace") as fh:
            tail = fh.read().strip().splitlines()[-5:]
        print("[varek] the Warden did not start the agent:", file=sys.stderr)
        for line in tail:
            print("   " + line, file=sys.stderr)
    return r.returncode


