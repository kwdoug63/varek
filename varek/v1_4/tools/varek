def run_for(s):
    """v1.28.1: whom a run acted for, short: the user (else the agent), and
    how many sub-agents ran"""
    who = str(s["user"].get("subject", "?")) if s["user"] else "agent"
    srv = len(s.get("mcp_servers", ()))                                            # v1.31
    n = len(s["subagents"]) - srv
    who = who if len(who) <= 20 else who[:19] + "~"
    return who + (f" +{n} sub-agent{'s' if n > 1 else ''}" if n > 0 else "") + \
        (f" +{srv} MCP server{'s' if srv > 1 else ''}" if srv else "")


def obo_text(r):
    """v1.28.1: the chain a record was for, after the agent: '' for the
    agent itself"""
    ob = r.get("obo")
    if not isinstance(ob, list):
        return ""
    subs = [x[len("subagent:"):] for x in ob if isinstance(x, str) and x.startswith("subagent:")]
