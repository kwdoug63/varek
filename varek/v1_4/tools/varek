#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""
varek: one command for running and checking the VAREK Warden.

The Warden and its tools (warden, vdp_check, vdp_cert_check, varek_keygen,
varek_audit.py, varek_cyclonedx.py, varek_preflight.sh) each take their own
arguments. This command wraps them for day-to-day use and reads the settings
they share from one file, /etc/varek/varek.conf, so an operator types

    sudo varek init --pack healthcare
    sudo varek run -- python3 agent.py
    varek refusals
    varek audit
    varek export
    sudo varek bench

instead of assembling each tool's flags. Every subcommand prints the
underlying command it runs with --show-commands, so nothing is hidden.

Settings:   /etc/varek/varek.conf (override with VAREK_CONFIG=<file>)
Runtime:    the directory above this script (override with VAREK_HOME=<dir>)
"""

import argparse
import configparser
import datetime as _dt
import glob
import hashlib
import json
import os
import platform
import re
import shlex
import shutil
import socket
import stat
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import varek_license  # noqa: E402
import varek_bench  # noqa: E402
import varek_baseline  # noqa: E402
import varek_suggest  # noqa: E402

CLI_VERSION = "1.3.0"
DEFAULT_CONFIG = "/etc/varek/varek.conf"
DEFAULT_ETC = "/etc/varek"
DEFAULT_LOG_DIR = "/var/log/varek"

SHOW_COMMANDS = False


# ------------------------------------------------------------------ output --

def _tty():
    return sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def _paint(code, text):
    return f"\033[{code}m{text}\033[0m" if _tty() else text


def ok(msg):
    print(f"  {_paint('32', 'OK  ')}  {msg}")


def warn(msg):
    print(f"  {_paint('33', 'WARN')}  {msg}")


def fail(msg):
    print(f"  {_paint('31', 'FAIL')}  {msg}")


def info(msg):
    print(msg)


def hint(msg):
    print(f"        {_paint('2', msg)}")


class CliError(Exception):
    """A problem the operator can fix; printed without a traceback."""

    def __init__(self, msg, fix=None, code=2):
        super().__init__(msg)
        self.fix = fix
        self.code = code


# ------------------------------------------------------------------ layout --

def varek_home():
    env = os.environ.get("VAREK_HOME")
    if env:
        return os.path.abspath(env)
    here = os.path.dirname(os.path.realpath(__file__))
    return os.path.dirname(here)  # tools/.. = the Warden's directory


def tool(name):
    home = varek_home()
    for p in (os.path.join(home, "tools", name), os.path.join(home, name)):
        if os.path.exists(p):
            return p
    return os.path.join(home, "tools", name)


def warden_bin():
    return os.path.join(varek_home(), "warden")


def config_path():
    return os.environ.get("VAREK_CONFIG", DEFAULT_CONFIG)


def load_config(required=True):
    path = config_path()
    cp = configparser.ConfigParser()
    if not os.path.exists(path):
        if required:
            raise CliError(f"no configuration at {path}",
                           fix="run `sudo varek init --pack <name>` first "
                               "(`varek policy list` shows the packs)")
        return None
    cp.read(path)
    if "varek" not in cp:
        raise CliError(f"{path} has no [varek] section", fix="re-run `sudo varek init`")
    c = cp["varek"]
    etc = os.path.dirname(os.path.abspath(path))
    return {
        "path": path,
        "etc": etc,
        "policy": c.get("policy", os.path.join(etc, "policy.txt")),
        "log_dir": c.get("log_dir", DEFAULT_LOG_DIR),
        "sign_key": c.get("sign_key", "").strip(),
        "anchor": c.get("anchor", "").strip(),
        "spool": c.get("spool", "").strip(),
        "run_as": c.get("run_as", "nobody").strip() or "nobody",
        "packs_dir": c.get("packs_dir", os.path.join(etc, "packs")),
        "implicit": False,
    }


def default_config():
    """v1.29: the settings `varek run` uses with no configuration (nothing
    set up first): the default log directory (VAREK_LOG_DIR), the signing
    key next to where varek.conf would be, no anchor."""
    etc = os.path.dirname(os.path.abspath(config_path()))
    key = os.path.join(etc, "log.key")
    return {"path": None, "etc": etc, "policy": "",
            "log_dir": os.environ.get("VAREK_LOG_DIR", DEFAULT_LOG_DIR),
            "sign_key": key if os.path.exists(key) else "", "anchor": "", "spool": "",
            "run_as": "", "packs_dir": os.path.join(etc, "packs"), "implicit": True}


def config_or_defaults():
    """The settings, or (v1.29) the defaults when there are none"""
    return load_config(required=False) or default_config()


def write_config(path, cfg):
    cp = configparser.ConfigParser()
    cp["varek"] = {k: cfg[k] for k in
                   ("policy", "log_dir", "sign_key", "anchor", "spool", "run_as", "packs_dir")}
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        fh.write("# VAREK settings, written by `varek init`. Edit by hand or re-run init.\n")
        fh.write("#   policy     the policy the Warden enforces\n")
        fh.write("#   log_dir    where each run's verdict stream is written\n")
        fh.write("#   sign_key   Ed25519 key that signs the stream (empty: unsigned)\n")
        fh.write("#   anchor     optional --anchor path (FIFO for an off-host anchor)\n")
        fh.write("#   spool      the anchor forwarder's spool directory, if any\n")
        fh.write("#   run_as     the unprivileged user the agent runs as\n")
        fh.write("#   packs_dir  where licensed policy packs are kept\n")
        cp.write(fh)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


# ----------------------------------------------------------------- helpers --

def run_cmd(argv, check=True, capture=False, **kw):
    if SHOW_COMMANDS:
        print(_paint("2", "$ " + " ".join(shlex.quote(a) for a in argv)), file=sys.stderr)
    opts = {"text": True}
    if capture:
        opts.update(stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    opts.update(kw)
    try:
        r = subprocess.run(argv, **opts)
    except FileNotFoundError:
        raise CliError(f"{argv[0]} is missing",
                       fix=f"build the runtime: `make` in {varek_home()}")
    if check and r.returncode != 0:
        detail = (r.stderr or r.stdout or "").strip() if capture else ""
        raise CliError(f"{os.path.basename(argv[0])} exited with {r.returncode}"
                       + (f": {detail}" if detail else ""), code=r.returncode or 1)
    return r


def need_root(what):
    if os.geteuid() != 0:
        raise CliError(f"{what} needs root", fix=f"run it with sudo: `sudo varek {what}`")


def sha256_file(path):
    with open(path, "rb") as fh:
        return hashlib.sha256(fh.read()).hexdigest()


def builtin_packs():
    out = {}
    for p in sorted(glob.glob(os.path.join(varek_home(), "policies", "*.policy.txt"))):
        out[os.path.basename(p)[:-len(".policy.txt")]] = p
    return out


def packs_dir(cfg):
    if cfg:
        return cfg["packs_dir"]
    return os.path.join(os.path.dirname(os.path.abspath(config_path())), "packs")


def installed_packs(cfg):
    out = {}
    d = packs_dir(cfg)
    if os.path.isdir(d):
        for p in sorted(glob.glob(os.path.join(d, "*.policy.txt"))):
            out[os.path.basename(p)[:-len(".policy.txt")]] = p
    return out


def backup_name(path):
    base = path + ".bak-" + _dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    name, n = base, 1
    while os.path.exists(name):
        name, n = f"{base}-{n}", n + 1
    return name


def resolve_pack(name, cfg):
    if os.path.isfile(name):
        return os.path.abspath(name)
    packs = {**builtin_packs(), **installed_packs(cfg)}
    if name in packs:
        return packs[name]
    raise CliError(f"no policy pack or file named '{name}'",
                   fix="`varek policy list` shows the packs; or give a path to a policy file")


def require_entitlement(src):
    """Enterprise packs need a VAREK Enterprise entitlement; everything else doesn't.

    Only the choice of an Enterprise pack is gated. The Warden and the
    open-source packs (VAREK Core) work with or without a license.
    """
    if not varek_license.is_enterprise_pack(src):
        return
    r = varek_license.check(varek_home())
    if r.ok:
        ok(f"VAREK Enterprise license: {r.dimension}")
        return
    name = os.path.basename(src)
    core = ", ".join(sorted(n for n, p in builtin_packs().items()
                            if not varek_license.is_enterprise_pack(p)))
    if r.status == varek_license.NOT_LICENSED:
        raise CliError(f"{name} is a VAREK Enterprise pack and this AWS account has no "
                       f"VAREK Enterprise subscription ({r.detail})",
                       fix=f"subscribe on AWS Marketplace, or use a VAREK Core pack: {core}")
    if r.status == varek_license.NOT_MARKETPLACE:
        raise CliError(f"{name} is a VAREK Enterprise pack; it runs on the VAREK Enterprise "
                       "AMI from AWS Marketplace",
                       fix=f"use a VAREK Core pack: {core}")
    raise CliError(f"{name} is a VAREK Enterprise pack and the license could not be "
                   f"checked: {r.detail}",
                   fix="attach an instance role allowing license-manager:CheckoutLicense "
                       "and license-manager:CheckInLicense (see `varek license`), then try again")


def pack_summary(path):
    """First descriptive comment line of a policy file."""
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                s = line.strip()
                if s.startswith("#@"):           # v1.29: a baseline's header
                    continue
                if s.startswith("#") and len(s) > 2 and not set(s[1:].strip()) <= set("-=_ "):
                    return s.lstrip("# ").strip()
    except OSError:
        pass
    return ""


def lint_policy(path):
    r = run_cmd([tool("vdp_check"), path, "lint"], check=False, capture=True)
    return r.returncode, (r.stdout + r.stderr).strip()


def policy_rules(path):
    counts = {"allow": {}, "deny": {}}
    require = None
    with open(path, encoding="utf-8", errors="replace") as fh:
        for raw in fh:
            line = raw.split("#", 1)[0].strip()
            if not line:
                continue
            parts = line.split()
            if parts[0] == "require" and len(parts) >= 3:
                require = parts[2]
            elif parts[0] in counts and len(parts) >= 2:
                counts[parts[0]][parts[1]] = counts[parts[0]].get(parts[1], 0) + 1
    return counts, require


def read_records(log):
    """The records of a verdict stream. v1.27 review: a line that looks like a
    record but is not one is never dropped silently; a stream with any is
    refused (a summary of part of a stream would mislead)."""
    recs, bad, other = [], 0, 0
    with open(log, encoding="utf-8", errors="replace") as fh:
        for raw in fh:
            line = raw.strip()
            if line.startswith("{"):
                try:
                    recs.append(json.loads(line))
                except ValueError:
                    if raw.endswith("\n"):
                        bad += 1             # (a last line still being written is not counted)
            elif line and not line.startswith("[warden"):
                other += 1
    if not recs and other:
        raise CliError(f"{log}: not a verdict stream (no records)")
    if bad:
        raise CliError(f"{log}: {bad} line(s) look like records but cannot be read; the stream is damaged or "
            f"not a verdict stream (varek audit says more)")
    return recs


def run_logs(cfg):
    d = cfg["log_dir"]
    if os.path.isdir(d) and not os.access(d, os.R_OK | os.X_OK):
        raise CliError(f"cannot read {d} (verdict streams are root-only)",
                       fix="run it with sudo, or pass a log file you can read")
    files = glob.glob(os.path.join(cfg["log_dir"], "verdicts-*.log"))
    return sorted(files, key=os.path.getmtime, reverse=True)


def latest_log(cfg, given=None):
    if given:
        if not os.path.isfile(given):
            raise CliError(f"no log at {given}")
        return given
    logs = run_logs(cfg)
    if not logs:
        raise CliError(f"no runs yet in {cfg['log_dir']}",
                       fix="start one with `sudo varek run -- <agent command>`")
    return logs[0]


def summarize(recs):
    s = {"run": None, "start": None, "complete": False, "warden": None, "policy": None,
         "policy_sha": None,
         "allowed": 0, "refused": 0, "unknown": 0, "refusals": [],
         "proxy_targets": {}, "proxy_denied": set(), "proxy_ends": [],
         "cred_refused": [], "revoked": None, "credentials": [],
         "user": None, "spiffe_id": None, "subagents": {}, "expired": None,
         "dry": False, "not_enforced": 0, "mcp_servers": set(), "mcp_calls": 0}
    for r in recs:
        ev = r.get("event")
        if r.get("enforced") is False and (s["run"] is None or r.get("run") == s["run"]):
            s["not_enforced"] += 1                                   # v1.29: a dry run let it through
        # v1.28 review: only this run's records (a stream can hold lines of
        # another run, which the audit ignores too)
        if s["run"] is not None and ev != "run_start" and "run" in r and r.get("run") != s["run"]:
            continue
        # v1.28.1 review: a line with no run id is not the Warden's (the agent's
        # stdout can share the file)
        if ev != "run_start" and "run" not in r:
            continue
        if ev == "run_start":
            if s["run"] is not None:
                continue
            s["run"] = r.get("run")
            s["warden"] = r.get("warden")
            s["policy"] = r.get("policy_path")
            s["policy_sha"] = r.get("policy_sha256")
            s["dry"] = r.get("mode") == "dry_run"                    # v1.29
            ts = r.get("timestamp_ns")
            if ts:
                s["start"] = _dt.datetime.fromtimestamp(ts / 1e9).strftime("%Y-%m-%d %H:%M:%S")
            if isinstance(r.get("credentials"), list):               # v1.28
                s["credentials"] = [c for c in r["credentials"] if isinstance(c, dict)]
            obo = r.get("on_behalf_of")                              # v1.28.1
            if isinstance(obo, dict):
                if isinstance(obo.get("user"), dict):
                    s["user"] = obo["user"]
                if isinstance(obo.get("agent"), dict) and isinstance(obo["agent"].get("spiffe_id"), str):
                    s["spiffe_id"] = obo["agent"]["spiffe_id"]
        elif ev == "run_end":
            s["complete"] = True
        elif ev == "credential_refused":
            # v1.28: a request the rule allowed with a credential, where the
            # proxy could not put the value in (the agent got a 403)
            s["cred_refused"].append(r)
        elif ev == "revoked" and s["revoked"] is None:
            s["revoked"] = r
        elif ev == "on_behalf_of_expired" and s["expired"] is None:    # v1.28.1
            s["expired"] = r
        elif ev == "proxy_close":
            # v1.26.1 (step 7): a connection the proxy ended: its parser
            # refused a request, a TLS handshake failed, or a body passed
            # max_body (a refusal by the Warden is its net.request record)
            if r.get("why") in ("refused_request", "server_tls", "client_tls", "tls_timeout", "max_body") \
                    and type(r.get("proxy_conn")) is int:
                s["proxy_ends"].append(r)
        elif ev == "dns_question" and (r.get("rule") == "wildcard_budget" or
                                       (r.get("rule") == "no_rule" and r.get("enforced") is False)):
            # v1.25: a name a wildcard rule's budget refused (NXDOMAIN);
            # v1.29: or, in a dry run, a name looked up that would be refused
            s["refused"] += 1
            s["refusals"].append(r)
        elif "decision_final" in r:
            d = r["decision_final"]
            ob = r.get("obo")                                          # v1.28.1: each sub-agent's decisions
            if isinstance(ob, list) and ob and isinstance(ob[-1], str) and ob[-1].startswith("subagent:"):
                t = ob[-1][len("subagent:"):]
                s["subagents"][t] = s["subagents"].get(t, 0) + 1
            if r.get("action") == "process.exec" and r.get("mcp_server") is True and r.get("subagent"):
                s["mcp_servers"].add(str(r["subagent"]))                 # v1.31
            if r.get("action") == "net.mcp":
                s["mcp_calls"] += 1
            if r.get("action") == "net.proxy" and isinstance(r.get("proxy_conn"), int):
                s["proxy_targets"].setdefault(r["proxy_conn"], r.get("target", ""))
            if r.get("action") in ("net.request", "net.mcp") and d != "ALLOW" and type(r.get("proxy_conn")) is int:
                s["proxy_denied"].add(r["proxy_conn"])                  # v1.31: an MCP call's refusal too
            if d == "ALLOW":
                s["allowed"] += 1
            else:
                if r.get("decision_raw") == "UNKNOWN":
                    s["unknown"] += 1
                s["refused"] += 1
                s["refusals"].append(r)
    return s


def verdict_word(r):
    raw = r.get("decision_raw", "")
    return {"ALLOW": "SATISFIED", "DENY": "UNSATISFIED", "UNKNOWN": "UNKNOWN"}.get(raw, raw)


def _pubkey(cfg):
    if cfg["sign_key"] and os.path.exists(cfg["sign_key"] + ".pub"):
        return cfg["sign_key"] + ".pub"
    return None


def _policy_for_log(cfg, s):
    """The policy file a run was decided with: the one whose SHA-256 matches
    run_start's, looked for where it was, then among backups and packs."""
    want = s.get("policy_sha")
    cands = [s.get("policy"), cfg["policy"]]
    cands += list(installed_packs(cfg).values()) + list(builtin_packs().values())
    if cfg["policy"]:
        cands += sorted(glob.glob(cfg["policy"] + ".bak-*"), reverse=True)
    seen = set()
    for c in cands:
        if not c or c in seen or not os.path.isfile(c):
            continue
        seen.add(c)
        if not want or sha256_file(c) == want:
            return c
    return None


# ------------------------------------------------------------- subcommands --

def mount_ns_ok():
    """v1.27.1: can this process make a mount namespace, as the Warden does
    (in a child, so this process keeps its own)? True, False, or None when
    not root (the Warden runs as root; nothing to learn as another user)."""
    if os.geteuid() != 0:
        return None
    import ctypes
    pid = os.fork()
    if pid == 0:
        try:
            os._exit(0 if ctypes.CDLL(None).unshare(0x20000) == 0 else 1)    # CLONE_NEWNS
        except Exception:
            os._exit(1)
    _, st = os.waitpid(pid, 0)
    return os.WIFEXITED(st) and os.WEXITSTATUS(st) == 0


def landlock_abi():
    """v1.27: (the Landlock ABI, "") or (0, why), probed as the Warden does
    (landlock_create_ruleset with LANDLOCK_CREATE_RULESET_VERSION)."""
    if platform.system() != "Linux" or platform.machine() != "x86_64":
        return 0, "not Linux on x86_64"
    import ctypes
    libc = ctypes.CDLL(None, use_errno=True)
    libc.syscall.restype = ctypes.c_long
    r = libc.syscall(ctypes.c_long(444), None, ctypes.c_size_t(0), ctypes.c_uint32(1))
    if r >= 1:
        return int(r), ""
    e = ctypes.get_errno()
    return 0, {38: "the kernel has no Landlock (5.13 or later is needed)",
               95: "Landlock is not enabled (it is not in the kernel's LSM list)"}.get(e, os.strerror(e))


def policy_credential_names(path):
    """v1.28: the credentials a policy names, as the certificate checker reads it."""
    q = run_cmd([tool("vdp_cert_check"), path, "credentials"], capture=True)
    return [ln.split(" ")[1] for ln in q.stdout.splitlines()
            if q.returncode == 0 and ln.startswith("credential ")]


def check_credentials(path):
    """v1.28: fetch each credential the policy names, as a run would (root:
    `warden --check-credentials`; values are not kept, a Vault lease the
    check makes is revoked). [(ok, text)] for each credential, or one line
    saying why the check could not finish."""
    r = subprocess.run([warden_bin(), path, "--check-credentials"], capture_output=True, text=True)
    got = [ln[len("[warden] credential "):] for ln in r.stderr.splitlines()
           if ln.startswith("[warden] credential ") and ": fetched, " in ln]
    out = [(True, g) for g in got]
    if r.returncode != 0:
        why = next((ln[len("[warden] "):] for ln in r.stderr.splitlines() if "refusing to start" in ln),
                   (r.stderr.strip().splitlines() or [f"exit {r.returncode}"])[-1])
        out.append((False, why))
    return out


def cgroup2_mount():
    """v1.28.1: where cgroup v2 is mounted, or None"""
    try:
        with open("/proc/self/mounts") as f:
            for ln in f:
                p = ln.split()
                if len(p) > 2 and p[2] == "cgroup2":
                    return p[1]
    except OSError:
        pass
    return None


def issuer_keys(iss, jwks=None, conf="/etc/varek/secrets.conf"):
    """v1.28.1: fetch an issuer's keys as warden-secrets would (its discovery
    document, then jwks_uri, or the policy's jwks URL; verified HTTPS, with
    the CA oidc_ca names if it can be read). (ok, what)"""
    import ssl
    import urllib.request
    ca = None
    try:
        with open(conf) as f:
            for ln in f:
                k, _, v = ln.partition("=")
                if k.strip() == "oidc_ca":
                    ca = v.strip()
    except OSError:
        pass
    ctx = ssl.create_default_context(cafile=ca) if ca else ssl.create_default_context()

    def get(url):
        if not url.startswith("https://"):
            raise ValueError(f"{url} is not https")
        with urllib.request.urlopen(urllib.request.Request(url, headers={"Accept": "application/json"}),
                                    timeout=10, context=ctx) as r:
            return json.loads(r.read(1 << 20))
    try:
        if not jwks:
            d = get(iss.rstrip("/") + "/.well-known/openid-configuration")
            if d.get("issuer") != iss:
                return False, f"its discovery document names another issuer ({d.get('issuer')!r})"
            jwks = d.get("jwks_uri")
            if not isinstance(jwks, str):
                return False, "its discovery document has no jwks_uri"
        keys = get(jwks).get("keys")
        if not isinstance(keys, list) or not keys:
            return False, f"no keys at {jwks}"
        kinds = sorted({str(k.get("kty")) for k in keys if isinstance(k, dict)})
        return True, f"{len(keys)} key(s) ({', '.join(kinds)}) at {jwks}"
    except Exception as e:                              # noqa: BLE001 (any failure is the answer)
        return False, f"its keys cannot be fetched: {e}"


def cmd_doctor(args):
    info("VAREK doctor: is this host ready to run the Warden?\n")
    bad = 0

    if platform.system() == "Linux" and platform.machine() == "x86_64":
        ok(f"Linux x86_64 ({platform.release()})")
    else:
        fail(f"{platform.system()} {platform.machine()}: the Warden needs Linux on x86_64")
        bad += 1

    m = re.match(r"(\d+)\.(\d+)", platform.release())
    if m and (int(m.group(1)), int(m.group(2))) >= (5, 14):
        ok("kernel 5.14 or later (seccomp user-notify with ADDFD_FLAG_SEND)")
    else:
        fail(f"kernel {platform.release()} is older than 5.14")
        hint("use Amazon Linux 2023, RHEL 9, Ubuntu 22.04 or later")
        bad += 1

    # v1.27: decided program launches need Landlock (the kernel holds the
    # agent to the launch set); without it such launches are refused
    abi, why = landlock_abi()
    if abi:
        ok(f"Landlock ABI {abi} (launches a policy allows with `require warden 1.27` can run)")
    else:
        warn(f"Landlock is not available ({why}): with `require warden 1.27` every launch after the "
             f"agent's own is refused")
        hint("Linux 5.13 or later with `landlock` in /sys/kernel/security/lsm (the kernel's lsm= list)")
    # v1.27.1: with `require warden 1.27` the Warden mounts the writable
    # directories noexec in a mount namespace of its own
    mns = mount_ns_ok()
    if mns is True:
        ok("Mount namespaces: the Warden can mount writable directories noexec (require warden 1.27)")
    elif mns is False:
        warn("The Warden cannot make a mount namespace here: a `require warden 1.27` run refuses to "
             "start unless given --writable-exec")
        hint("run the Warden as root (it needs CAP_SYS_ADMIN), outside a container that forbids unshare")

    # v1.29: a dry run lets a refused call through with CONTINUE (5.5, within
    # the 5.14 above); the baseline runs the agent as the user who ran sudo
    if m and (int(m.group(1)), int(m.group(2))) >= (5, 14):
        ok("dry runs available (`varek run --dry-run` records what the policy would refuse, enforcing nothing)")
    pw, ra, why_user = varek_baseline.agent_user(None)
    if pw is None:
        warn(f"the agent's user ({ra}, {why_user}) has no passwd entry: `varek run` with no settings will "
             f"not start")
    elif pw.pw_uid == 0:
        fail("the agent's user would be root")
        bad += 1
    elif not os.path.isdir(pw.pw_dir) and ra != "nobody":
        warn(f"the agent's user {ra} ({why_user}) has no home directory {pw.pw_dir}: the baseline "
             f"gives it none")
    else:
        ok(f"the baseline runs the agent as {ra} ({why_user})" +
           ("; run `sudo varek run` from your own account to run it as you" if ra == "nobody" else ""))

    cg2 = cgroup2_mount()                                                         # v1.28.1
    if cg2:
        ok(f"cgroup v2 at {cg2} (a policy's sub-agents can each have a control group)")
    else:
        warn("cgroup v2 not mounted: a policy that names a sub-agent (subagent=) will not start")

    missing = [n for n in ("warden", "warden-proxy", "tools/vdp_check", "tools/vdp_cert_check", "tools/varek_keygen")
               if not os.access(os.path.join(varek_home(), n), os.X_OK)]
    if missing:
        fail("runtime not built: " + ", ".join(missing))
        hint(f"cd {varek_home()} && make deps && make")
        bad += 1
    else:
        ok(f"runtime built in {varek_home()}")

    if os.geteuid() == 0:
        ok("running as root (init, run and preflight need it)")
    else:
        warn("not root: `varek init`, `varek run` and `varek preflight` need sudo")

    cfg = None
    try:
        cfg = load_config()
        ok(f"settings in {cfg['path']}")
    except CliError as e:
        fail(str(e))
        hint(e.fix)
        bad += 1

    if cfg:
        if os.path.isfile(cfg["policy"]):
            rc, out = lint_policy(cfg["policy"]) if not missing else (1, "runtime not built")
            if rc == 0:
                ok(f"policy {cfg['policy']} loads and lints")
                # v1.28.1: the policy's sub-agents need cgroup v2; its issuers' keys must be reachable
                iq = run_cmd([tool("vdp_cert_check"), cfg["policy"], "identity"], capture=True)
                ident = iq.stdout.splitlines() if iq.returncode == 0 else []
                if any(ln.startswith("subagent ") for ln in ident) and not cg2:
                    fail("the policy names a sub-agent, and this host has no cgroup v2: it will not start")
                    bad += 1
                for ln in ident:
                    f = ln.split(" ")
                    if len(f) == 4 and f[0] == "issuer":
                        good, text = issuer_keys(f[1], None if f[3] == "-" else f[3])
                        if good:
                            ok(f"issuer {f[1]}: {text}")
                        else:
                            fail(f"issuer {f[1]}: {text}")
                            hint("a run with --on-behalf-of fetches these keys at its start; oidc_ca in "
                                 "/etc/varek/secrets.conf names a CA for the issuer")
                            bad += 1
                # v1.31: each MCP server's (confined sub-agent's) file
                for good, text in check_server_files(cfg["policy"]):
                    if good:
                        ok(text)
                    else:
                        fail(text)
                        hint("a confined subject's file must be root's, written by no one else, and its pin current")
                        bad += 1
                # v1.28: each credential the policy names can be fetched
                names = policy_credential_names(cfg["policy"])
                if names and os.geteuid() != 0:
                    warn(f"the policy names {len(names)} credential(s); run `sudo varek doctor` to fetch each "
                         f"(warden-secrets needs root)")
                elif names:
                    for good, text in check_credentials(cfg["policy"]):
                        if good:
                            ok(f"credential {text}")
                        else:
                            fail(f"credentials: {text}")
                            hint("/etc/varek/secrets.conf names the stores (docs/security/v1.28-credential-release.md)")
                            bad += 1
            else:
                fail(f"policy {cfg['policy']} does not lint: {out.splitlines()[-1] if out else rc}")
                hint("`varek policy check` shows every problem")
                bad += 1
        else:
            fail(f"policy {cfg['policy']} is missing")
            hint("`sudo varek policy use <pack>`")
            bad += 1

        if cfg["sign_key"]:
            try:
                st = os.stat(cfg["sign_key"])
                if st.st_mode & 0o077:
                    fail(f"signing key {cfg['sign_key']} is readable by group or others")
                    hint(f"sudo chmod 600 {cfg['sign_key']}")
                    bad += 1
                else:
                    ok(f"signing key {cfg['sign_key']} (mode 600)")
            except PermissionError:
                ok(f"signing key {cfg['sign_key']} exists (unreadable to you, as it should be)")
            except FileNotFoundError:
                fail(f"signing key {cfg['sign_key']} is missing")
                hint("`sudo varek init --force-key` makes a new one")
                bad += 1
        else:
            warn("no signing key: verdict streams are hash-chained but not signed")

        d = cfg["log_dir"]
        if os.path.isdir(d):
            st = os.stat(d)
            if st.st_mode & 0o002:
                fail(f"log directory {d} is writable by everyone")
                bad += 1
            else:
                ok(f"log directory {d}")
        else:
            fail(f"log directory {d} is missing")
            hint(f"sudo install -d -m 0750 {d}")
            bad += 1

        if cfg["anchor"]:
            ok(f"anchor {cfg['anchor']}")
        else:
            warn("no off-host anchor: root on this host could rewrite unanchored history")
            hint("see `Off-host anchor` in the Warden README to add one")

    if os.path.exists(os.path.join(varek_home(), varek_license.MARKETPLACE_FILE)):
        r = varek_license.check(varek_home())
        if r.ok:
            ok(f"VAREK Enterprise license: {r.dimension}")
        elif r.status == varek_license.NOT_LICENSED:
            warn("no VAREK Enterprise entitlement: the VAREK Core packs still work")
        else:
            warn(f"VAREK Enterprise license not checked: {r.detail}")
            hint("`varek license` shows the IAM permission the instance needs")

    print()
    if bad:
        info(f"{bad} problem(s) to fix before running agents.")
        return 1
    info("Ready. Next: `sudo varek preflight --run`, then `sudo varek run -- <agent command>`.")
    return 0


def cmd_init(args):
    need_root("init")
    path = config_path()
    etc = os.path.dirname(os.path.abspath(path))
    existing = load_config(required=False)
    if existing and not args.force:
        raise CliError(f"{path} already exists",
                       fix="use `sudo varek policy use <pack>` to change the policy, "
                           "or `sudo varek init --force ...` to start over")
    if not args.pack:
        names = ", ".join(sorted({**builtin_packs(), **installed_packs(existing)}))
        raise CliError("choose a policy pack with --pack",
                       fix=f"packs: {names}; or --pack /path/to/policy.txt")

    src = resolve_pack(args.pack, existing)
    rc, out = lint_policy(src)
    if rc != 0:
        raise CliError(f"{src} does not lint:\n{out}")
    require_entitlement(src)

    info(f"Setting up VAREK in {etc}\n")
    os.makedirs(etc, exist_ok=True)
    os.chmod(etc, 0o755)
    pdir = os.path.join(etc, "packs")
    os.makedirs(pdir, exist_ok=True)

    policy = os.path.join(etc, "policy.txt")
    if os.path.exists(policy) and sha256_file(policy) != sha256_file(src):
        backup = backup_name(policy)
        shutil.copy2(policy, backup)
        ok(f"previous policy kept as {backup}")
    shutil.copyfile(src, policy)
    os.chmod(policy, 0o644)
    ok(f"policy {os.path.basename(src)} -> {policy}")

    key = ""
    if not args.no_sign:
        key = os.path.join(etc, "log.key")
        if os.path.exists(key) and not args.force_key:
            ok(f"signing key {key} kept (use --force-key to replace it)")
        else:
            for p in (key, key + ".pub"):
                if os.path.exists(p):
                    os.remove(p)
            run_cmd([tool("varek_keygen"), key], capture=True)
            ok(f"signing key {key} (600) and {key}.pub")
    else:
        warn("no signing key (--no-sign): streams will be chained but not signed")

    log_dir = args.log_dir or DEFAULT_LOG_DIR
    os.makedirs(log_dir, exist_ok=True)
    os.chmod(log_dir, 0o750)
    ok(f"log directory {log_dir} (750)")

    cfg = {"policy": policy, "log_dir": log_dir, "sign_key": key,
           "anchor": args.anchor or "", "spool": args.spool or "",
           "run_as": args.run_as or "nobody", "packs_dir": pdir}
    write_config(path, cfg)
    ok(f"settings written to {path}")

    print()
    info("Done. Next steps:")
    info("  sudo varek preflight --run      # a real trial run, then its audit")
    info("  sudo varek run -- <agent command>")
    return 0


def cmd_policy_list(args):
    cfg = load_config(required=False)
    active = sha256_file(cfg["policy"]) if cfg and os.path.isfile(cfg["policy"]) else None
    rows = [(n, p, "built-in") for n, p in builtin_packs().items()] + \
           [(n, p, "installed") for n, p in installed_packs(cfg).items()]
    if not rows:
        info("No policy packs found.")
        return 0
    width = max(len(n) for n, _, _ in rows)
    info("Policy packs (use with `sudo varek policy use <name>`):\n")
    any_ent = False
    for n, p, kind in rows:
        mark = "*" if active and sha256_file(p) == active else " "
        if varek_license.is_enterprise_pack(p):
            kind, any_ent = "enterprise", True
        info(f" {mark} {n.ljust(width)}  {kind:10}  {pack_summary(p)}")
    if active:
        info("\n * = the active policy")
    if any_ent:
        info("enterprise = needs a VAREK Enterprise subscription (`varek license` checks it)")
    return 0


def cmd_license(args):
    try:
        mp = varek_license.load_marketplace(varek_home())
    except ValueError as e:
        raise CliError(str(e))
    if mp is None:
        info("This is VAREK Core (open source). No license is needed or checked.")
        info("VAREK Enterprise, with the HIPAA and SOC 2 packs, is sold on AWS Marketplace.")
        return 0
    info(f"VAREK Enterprise, AWS Marketplace product {mp['product_id']}")
    info(f"Checking for: {', '.join(mp['dimensions'])}\n")
    r = varek_license.check(varek_home())
    if r.ok:
        ok(f"licensed: {r.dimension}")
        if "not returned" in r.detail:
            warn(r.detail)
            hint("allow license-manager:CheckInLicense in the instance role, "
                 "or checks within the next hour are refused")
        return 0
    if r.status == varek_license.NOT_LICENSED:
        warn(f"no VAREK Enterprise entitlement for this AWS account ({r.detail})")
        hint("if this account does hold a subscription, a check made in the last hour "
             "may still hold it; see `Troubleshooting` in docs/aws-deployment-guide.md")
        hint("the Warden and the VAREK Core packs keep working; Enterprise packs can't be chosen")
        return 1
    fail(f"could not check the license: {r.detail}")
    hint("the instance needs an IAM role with these permissions:")
    hint('  {"Effect": "Allow", "Action": ["license-manager:CheckoutLicense",')
    hint('   "license-manager:CheckInLicense"], "Resource": "*"}')
    return 1


def cmd_policy_show(args):
    cfg = load_config(required=not args.file)
    path = resolve_pack(args.file, cfg) if args.file else cfg["policy"]
    counts, require = policy_rules(path)
    digest = run_cmd([tool("vdp_cert_check"), path, "digest"], capture=True).stdout.strip()
    info(f"Policy   {path}")
    info(f"About    {pack_summary(path)}")
    info(f"SHA-256  {digest}   (recorded in every run's run_start)")
    info(f"Needs    Warden {require or 'any version'}")
    hdr = baseline_header(path)                                                     # v1.29
    if hdr:
        prof = hdr.get("profile", "none -").split()
        info(f"Baseline written by `varek run` (format {hdr.get('varek baseline', '?')}) for user "
             f"{hdr.get('user', '?')}, working directory {hdr.get('cwd', '?')}, home {hdr.get('home', '?')}, "
             f"temporary directory {hdr.get('tmp', '?')}; profile " +
             (f"{prof[0]} (sha256 {prof[1][:16]}...)" if prof and prof[0] != "none" and len(prof) > 1 else "none"))
    show_rc = 0
    for verb in ("allow", "deny"):
        parts = ", ".join(f"{v} {k}" for k, v in sorted(counts[verb].items())) or "none"
        info(f"{verb.capitalize():8} {parts}")
    # v1.26: the egress proxy, as the certificate checker reads it
    pq = run_cmd([tool("vdp_cert_check"), path, "proxy"], capture=True)
    pf = pq.stdout.split() if pq.returncode == 0 else []
    proxy_on = bool(pf) and pf[0] in ("on", "inspect")
    if proxy_on:
        # v1.26.1: "inspect" (inspecting mode), then ports, upstream, passthrough
        ends = [pf.index(w) for w in ("upstream", "passthrough") if w in pf]
        ports = pf[1:min(ends)] if ends else pf[1:]
        up = pf[pf.index("upstream") + 1] if "upstream" in pf[:-1] else None
        passthrough = pf[pf.index("passthrough") + 1:] if "passthrough" in pf else []
        if pf[0] == "inspect":
            info(f"Proxy    inspecting mode, ports {', '.join(ports)}: on those ports a name is reached only "
                 f"through the egress proxy, which terminates TLS, and every request is decided by the "
                 f"request rules (a request no rule allows is refused)")
        else:
            info(f"Proxy    on, SNI mode, ports {', '.join(ports)}: on those ports a name is reached only "
                 f"through the egress proxy, decided on the TLS SNI or HTTP Host the agent sends")
        if up:
            info(f"Upstream http://{up}: after the Warden decides, the proxy forwards through it (CONNECT)")
        for h in passthrough:
            info(f"Passthrough {h}: kept in SNI mode, relayed without decrypting; its requests are not seen")
    # v1.27: launches after the first, as the certificate checker reads the policy
    lq = run_cmd([tool("vdp_cert_check"), path, "launches"], capture=True)
    has_exec = counts["allow"].get("exec", 0) > 0
    if lq.returncode == 0 and lq.stdout.strip() == "on":
        # the set the Warden would build on this host (its own expansion of the rules)
        w = os.path.join(varek_home(), "warden")
        r = subprocess.run([w, path, "--check-startup"], capture_output=True, text=True) \
            if os.access(w, os.X_OK) else None       # v1.27.1: the noexec list too, exec rules or not
        if r is not None and r.returncode != 0:
            # v1.27 review: say first that it would not start, and claim nothing it would allow
            why = next((ln for ln in r.stderr.splitlines() if "refusing to start" in ln), "")
            warn(f"The Warden would not start with this policy here: {why or r.returncode}")
            show_rc = 1
        else:
            info("Launches decided by the exec rules (require warden 1.27): a program the policy allows "
                 "can be launched, enforced by the kernel's Landlock ruleset built at startup"
                 if has_exec else "Launches decided (require warden 1.27), but no exec rule allows one: "
                 "every launch after the agent's own is refused")
        if r is not None and r.returncode == 0:
            sub = [ln[len("[warden]   "):] for ln in r.stderr.splitlines() if ln.startswith("[warden]   ")]
            files = [ln for ln in sub if not ln.startswith("noexec ")]
            head = next((ln[len("[warden] "):] for ln in r.stderr.splitlines()
                         if ln.startswith("[warden] launch set:")), None)
            if head and has_exec:
                info(f"Launch set on this host: {head[len('launch set: '):]}")
                for ln in files:
                    info(f"  {ln}")
            # v1.27.1: the directories the agent may write, mounted noexec
            nx = [ln[len("noexec "):] for ln in sub if ln.startswith("noexec ")]
            info("Mounted noexec (v1.27.1): files the agent may write can be neither launched nor "
                 "mapped executable" + (":" if nx else ": none (the policy lets the agent write nowhere)"))
            for ln in nx:
                info(f"  {ln}")
    elif has_exec:
        info("Launches after the agent's own are refused: exec rules take effect for them only "
             "with `require warden 1.27`")
    # v1.25: each wildcard allow rule's budgets (the Warden's defaults filled
    # in), as the certificate checker parses the file (v1.25 review: not this
    # tool's own reading, which split lines on a bare CR where the Warden does not)
    rq = run_cmd([tool("vdp_cert_check"), path, "rules"], capture=True)
    for ln in rq.stdout.splitlines() if rq.returncode == 0 else []:
        f = ln.split()
        if len(f) == 11 and f[0] == "r":
            # v1.26.1: a request rule, from its glob over "METHOD scheme://host:port/path"
            g = bytes.fromhex(f[10]).decode("latin-1").replace("\\?", "?").replace("://?*.", "://*.")
            mb = f", bodies at most {int(f[9]):,} bytes" if f[9] != "0" else ""
            info(f"Request  {'allow' if f[1] == 'a' else 'deny '} {g} (line {f[6]}){mb}")
        if len(f) == 11 and f[0] == "h" and f[1] == "a" and f[5] == "w":
            c = bytes.fromhex(f[10]).decode("latin-1")
            sfx, _, port = c[3:].rpartition(":")
            info(f"Wildcard *.{sfx}{'' if port == '*' else ':' + port} (line {f[6]}): at most "
                 f"{f[7] if f[7] != '0' else '256'} new names a run, {f[8] if f[8] != '0' else '30'} "
                 f"lookups upstream a minute, 63 bytes before the suffix; " +
                 ("names under it leave the host when the Warden looks them up to dial a request "
                  "it allowed (acknowledge=dns-channel)" if proxy_on else
                  "the agent's lookups under it leave the host (acknowledge=dns-channel)"))
    # v1.28: credential release, as the certificate checker reads the policy
    cq = run_cmd([tool("vdp_cert_check"), path, "credentials"], capture=True)
    creds, crules, cauds = [], [], {}
    for ln in cq.stdout.splitlines() if cq.returncode == 0 else []:
        f = ln.split(" ")
        if len(f) == 4 and f[0] == "credential":
            creds.append(f[1:])
        elif len(f) == 5 and f[0] == "rule":
            crules.append(f[1:])
        elif len(f) == 4 and f[0] == "audience":                     # v1.31: an MCP token
            cauds[f[1]] = (f[2], f[3] == "opaque")
    if creds:
        info(f"Credentials ({len(creds)}): fetched at startup by warden-secrets; the agent gets a placeholder in "
             f"VAREK_CRED_<NAME>, and the proxy puts the value in only where a rule below names it")
        for name, store, ref in creds:
            used = [r for r in crules if r[1] == name]
            info(f"  {name} from {store}:{ref}" +
                 (f": an MCP token for {cauds[name][0]}" + (" (opaque)" if cauds[name][1] else
                                                            ", checked for that audience and expiry when fetched")
                  if name in cauds else ""))
            for line, _, hdr, scheme in used:
                info(f"    line {line}: in {hdr}" + (f" after {scheme}" if scheme != "-" else ""))
            if not used:
                info("    no rule carries it (fetched, never sent)")
    # v1.28.1: whom a run acts for, as the certificate checker reads the policy
    iq = run_cmd([tool("vdp_cert_check"), path, "identity"], capture=True)
    issuers, domains, subs, req, mres = [], [], [], False, []
    for ln in iq.stdout.splitlines() if iq.returncode == 0 else []:
        f = ln.split(" ")
        if len(f) == 4 and f[0] == "issuer":
            issuers.append(f[1:])
        elif len(f) == 3 and f[0] == "spiffe":
            domains.append(f[1:])
        elif len(f) == 3 and f[0] == "subagent":
            subs.append(f[1:])
        elif ln == "require on-behalf-of":
            req = True
        elif len(f) == 3 and f[0] == "mcp-resource":                  # v1.31
            mres.append(f[1:])
    for url, aud in mres:
        info(f"MCP resource {url}: a user's token from an authorization server its metadata names "
             f"(RFC 9728) is verified for {aud if aud != '-' else url}")
    for iss, aud, jwks in issuers:
        info(f"Issuer   {iss}: a user's token it issued for {aud} is verified at the start (keys from "
             f"{jwks if jwks != '-' else 'its discovery document'}; --on-behalf-of)")
    for dom, bundle in domains:
        info(f"SPIFFE   {dom}: the agent's SVID is verified against {bundle} (--agent-svid)")
    if req:
        info("Requires a verified user: a run without --on-behalf-of refuses to start")
    if subs:
        info(f"Sub-agents ({len(subs)} rule(s)): each launch runs in its own control group, and every call it "
             f"makes is recorded as for it")
        for line, name in subs:
            text = policy_line_text(path, int(line)) if line.isdigit() else None
            info(f"  {name}: line {line}" + (f": {text}" if text else ""))
    servers, forl = policy_servers(path)                                          # v1.31
    if servers:
        info(f"Confined ({len(servers)}): each is decided by its own rules (for=NAME) and no one else's; the "
             f"agent's rules do not apply to it, nor its rules to the agent")
        for sv in servers:
            n = sum(1 for k in forl.values() if k == sv["k"])
            info(f"  {'MCP server' if sv['mcp'] else 'sub-agent'} {sv['name']}: {sv['file']} (line {sv['line']}), " +
                 (f"pinned to sha256 {sv['sha'][:16]}..." if sv["sha"] else "not pinned") + f"; {n} rule(s) for it")
            for line, name, hdr, scheme in crules:
                if line.isdigit() and forl.get(int(line)) == sv["k"]:
                    info(f"    credential {name}: line {line}, in {hdr}" + (f" after {scheme}" if scheme != "-" else ""))
    info("Anything not allowed is UNKNOWN and refused.")
    return show_rc


def baseline_header(path):
    """v1.29: a baseline's `#@ key value` lines (a dict), else {}"""
    h = {}
    try:
        with open(path, errors="replace") as f:
            for ln in f:
                if not ln.startswith("#@ "):
                    break
                body = ln[3:].rstrip("\n")
                if body.startswith("varek baseline "):
                    h["varek baseline"] = body[len("varek baseline "):]
                else:
                    k, _, v = body.partition(" ")
                    h[k] = v
    except OSError:
        return {}
    return h if "varek baseline" in h else {}


def cmd_policy_suggest(args):
    """v1.29: a draft policy from a run's refusals (varek_suggest.py)"""
    cfg = config_or_defaults()
    log = latest_log(cfg, args.log)
    recs = read_records(log)
    s = summarize(recs)
    pol = _policy_for_log(cfg, s)
    if not pol:
        raise CliError(f"the policy {log}'s run used (sha256 {s.get('policy_sha') or '?'}) was not found",
                       fix="the run's policy file must still be where it was, or among the packs")
    with open(pol, encoding="utf-8", errors="surrogateescape") as fh:
        text = fh.read()
    try:
        draft, active, commented = varek_suggest.suggest(recs, text, pol, s.get("policy_sha") or "?",
                                                         tool("vdp_check"), for_name=args.for_)
    except (ValueError, RuntimeError) as e:
        raise CliError(str(e))
    if args.output:
        if os.path.exists(args.output) and not args.force:
            raise CliError(f"{args.output} exists", fix="choose another file, or pass --force")
        with open(args.output, "w", encoding="utf-8", errors="surrogateescape") as fh:
            fh.write(draft)
        ok(f"draft written to {args.output}")
    else:
        sys.stdout.write(draft)
    print(_paint("2", f"[varek] a DRAFT from run {s['run'] or '?'}"
                      f"{' (a dry run)' if s.get('dry') else ''}: {active} rule(s) suggested, {commented} "
                      f"written commented out with the reason; read each before `varek policy use`"),
          file=sys.stderr)
    return 0


