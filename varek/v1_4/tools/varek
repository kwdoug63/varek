def cmd_refusals(args):
    cfg = config_or_defaults()
    log = latest_log(cfg, args.log)
    s = summarize(read_records(log))
    policy = _policy_for_log(cfg, s)
    # v1.26.1: connections the proxy ended itself (a refusal by the Warden is
    # its net.request record, listed with the others)
    ends = [e for e in s["proxy_ends"]
            if not (e.get("why") == "refused_request" and e.get("proxy_conn") in s["proxy_denied"])]
    if s["user"] or s["subagents"]:                                                 # v1.28.1
        u = s["user"]
        info(("On behalf of " + f"{u.get('subject')} (token from {u.get('issuer')}, "
              f"{'verified' if u.get('verified') is True else 'NOT marked verified'})" if u else
              "On behalf of no user (no token was given)") +
             (f"; sub-agents: {', '.join(f'{t}' + (' (MCP server)' if t in s['mcp_servers'] else '') + f' ({n} decisions)' for t, n in sorted(s['subagents'].items()))}"
              if s["subagents"] else "") + ".")
        if s["expired"]:
            info(f"The user's token expired during the run ({'the run was revoked' if s['expired'].get('action') == 'revoke' else 'recorded; the run went on'}).")
        info("")
    if getattr(args, "for_", None):                                                # v1.31: --for NAME
        args.subagent = args.for_
    if args.user is not None or args.subagent is not None:                         # v1.28.1: filters
        if args.user is not None and (not s["user"] or s["user"].get("subject") != args.user):
            info(f"This run was not on behalf of {args.user}" +
                 (f" (it was on behalf of {s['user'].get('subject')})." if s["user"] else " (no user)."))
            return 0
        if args.subagent is not None and getattr(args, "for_", None) and policy:
            # v1.31 review: --for NAME: the refusals decided as that confined
            # subject (the innermost one in each chain), as suggest --for
            conf = varek_suggest.confined_subjects(tool("vdp_check"), policy)
            want = conf.get(args.for_)
            if want is None:
                raise CliError(f"{args.for_} is not a confined subject of the policy this run used",
                               fix="`varek policy show` lists its MCP servers and confined sub-agents")
            s["refusals"] = [r for r in s["refusals"] if varek_suggest.subject_of(r, conf) == want]
            s["refused"] = len(s["refusals"])
            ends, s["cred_refused"] = [], []
        elif args.subagent is not None:
            s["refusals"] = [r for r in s["refusals"] if isinstance(r.get("obo"), list) and
                             any(isinstance(x, str) and x.startswith(f"subagent:{args.subagent}#") for x in r["obo"])]
            s["refused"] = len(s["refusals"])
            ends, s["cred_refused"] = [], []                   # not one process's: not filtered, not shown
    if s["revoked"]:                                                                # v1.28
        rv = s["revoked"]
        ts = rv.get("timestamp_ns")
        try:
            when = _dt.datetime.fromtimestamp(ts / 1e9).strftime("%Y-%m-%d %H:%M:%S")
        except (TypeError, ValueError, OverflowError, OSError):      # v1.28 review: no crash on a bad time
            when = "?"
        how = ("the user's token expired" if rv.get("by") == "on_behalf_of_expiry"        # v1.28.1
               else f"varek revoke, by uid {rv.get('by_uid', '?')}")
        info(f"The run was revoked at {when} ({how}): every call after it was refused.\n")
    if s["dry"]:                                                                    # v1.29
        info(_paint("1;33", f"DRY RUN, NOT ENFORCING: {s['not_enforced']} call(s) the policy refuses were let "
                            "through (listed as WOULD_REFUSE); calls refused all the same are listed as "
                            "refused.") + "\n")
    if args.enforced or args.not_enforced:                                          # v1.29: filters
        keep = (lambda r: r.get("enforced") is not False) if args.enforced else (lambda r: r.get("enforced") is False)
        s["refusals"] = [r for r in s["refusals"] if keep(r)]
        s["refused"] = len(s["refusals"])
        if args.not_enforced:
            ends, s["cred_refused"] = [], []                   # always enforced: not shown
    if not s["refusals"] and not ends and not s["cred_refused"]:
        info(f"No {'refusals' if not args.not_enforced else 'calls let through'} in {log}" +
             (f" for sub-agent {args.subagent}" if args.subagent else "") + ".")
        return 0
    info(f"{s['refused']} refused action(s) in {log}" +
         (f" ({sum(1 for r in s['refusals'] if r.get('enforced') is False)} not enforced)" if s["dry"] else "") +
         ":\n")
    for r in s["refusals"][: args.n]:
        line = r.get("policy_line", -1)
        dry = r.get("enforced") is False                                            # v1.29
        if r.get("action") == "net.request":
            # v1.26.1: a request on an inspected connection; the agent got a
            # 403 and the connection ended after it
            text = policy_line_text(policy, line) if policy and isinstance(line, int) and line >= 0 else None
            rl = r.get("rule")
            if rl == "max_body":
                word = "MAX_BODY"
                where = (f"policy line {line}" + (f": {text}" if text else "") + " allows it, but its body "
                         f"({r.get('body_declared', '?')} bytes declared) is over that rule's max_body")
            elif rl == "revoked":
                word, where = "REVOKED", RULE_WORDS["revoked"]
            elif isinstance(line, int) and line >= 0:
                word, where = verdict_word(r), f"policy line {line}" + (f": {text}" if text else
                                                                        " (that policy file is no longer on this host)")
            elif rl == "default_deny_unknown":
                word, where = verdict_word(r), "no request rule allows it"
            else:
                word, where = verdict_word(r), RULE_WORDS.get(rl, rl or "no rule matched")
            info(f"  {'WOULD_REFUSE' if dry else word:11}  {'net.request':13}  {r.get('target', '')}")
            hint(f"{where}; " + ("let through (dry run: not enforced)" if dry else
                                 "the agent got 403 Forbidden and the connection ended"))
            continue
        if r.get("action") == "net.mcp":                                            # v1.31: an MCP call
            rl = r.get("rule")
            text = policy_line_text(policy, line) if policy and isinstance(line, int) and line > 0 else None
            what = {"mcp_unreadable": f"the call could not be read: {r.get('mcp_error', '?')}",
                    "mcp_header_mismatch": f"its headers disagree with its body: {r.get('mcp_error', '?')}",
                    "mcp_token_user": "its bearer token is the run's user token",
                    "mcp_token_audience": "its bearer token is for another server",
                    "mcp_token_expired": "its bearer token has expired",
                    "mcp_token_malformed": "its bearer token is a JWT that cannot be read",
                    "credential_expired": "the MCP token its rule names has expired",
                    "max_body": "its body is over its rule's max_body",
                    "revoked": RULE_WORDS["revoked"]}.get(rl) or \
                (f"policy line {line}" + (f": {text}" if text else "") if isinstance(line, int) and line > 0
                 else "no mcp rule allows it")
            call = f"{r.get('mcp_method') or '?'} {r.get('mcp_name') or ''}".rstrip()
            info(f"  {'WOULD_REFUSE' if dry else verdict_word(r):11}  {'net.mcp':13}  {call} at {r.get('mcp_url', '?')}")
            ch = obo_text(r)
            hint(f"{what}; " + ("let through (dry run: not enforced)" if dry else
                                f"{'sub-agent ' + ch if ch else 'the agent'} got a JSON-RPC error in a 403"))
            continue
        rl = r.get("rule")
        if rl == "subagent_env":
            # v1.31 review: a confined subject launched with a variable that names code
            if r.get("action") == "process.exec":
                info(f"  {verdict_word(r):11}  {'process.exec':13}  {r.get('resolved') or r.get('target', '?')}")
                hint(f"a confined subject's launch with {r.get('env', '?')} set, which names code its launcher "
                     f"chose (it would run under the subject's rules); launch it without that variable")
            else:
                info(f"  {'KILLED':11}  {r.get('action', '?'):13}  pid {r.get('agent_pid')} ({r.get('exe', '?')})")
                hint(f"launched as a confined subject with {r.get('env', '?')} set after its launch was decided; "
                     f"the process was killed before this call was answered")
            continue
        if rl == "exec_identity_mismatch":
            # v1.27: a process found running a program the Warden did not decide to run
            info(f"  {'KILLED':11}  {r.get('action', '?'):13}  pid {r.get('agent_pid')} ran {r.get('exe', '?')}")
            hint("not a program the Warden decided to run (a launch's path changed after its decision, "
                 "or a kernel fault); the process was killed before this call was answered")
            continue
        if r.get("action") == "process.exec" and rl in EXEC_WORDS:
            word, what = EXEC_WORDS[rl]
            text = policy_line_text(policy, line) if policy and isinstance(line, int) and line >= 0 else None
            info(f"  {'WOULD_REFUSE' if dry else word:11}  {'process.exec':13}  {r.get('resolved') or r.get('target', '')}")
            hint(f"policy line {line}" + (f": {text}" if text else "") + f" {what}; " +
                 ("let through (dry run: not enforced)" if dry else "the agent got EACCES"))
            continue
        if r.get("event") == "dns_question" and r.get("rule") == "no_rule":         # v1.29: a dry run
            info(f"  {'WOULD_REFUSE':11}  {'dns.question':13}  {r.get('name', '')}")
            hint("no rule names it; looked up all the same (dry run: not enforced)")
            continue
        if r.get("event") == "dns_question":
            text = policy_line_text(policy, line) if policy and isinstance(line, int) else None
            b = r.get("budget")
            what = {"names": "its names= budget (new names per run) is spent",
                    "rate": "its rate= budget (lookups upstream per minute) is spent",
                    "label": "the part before the suffix is longer than 63 bytes"}.get(
                        b if isinstance(b, str) else "", "a budget")   # v1.25 review: no crash on a list
            info(f"  {'WOULD_REFUSE' if dry else 'BUDGET':11}  {'dns.question':13}  {r.get('name', '')}")
            hint(f"policy line {line}" + (f": {text}" if text else "") + f"; {what}; " +
                 ("looked up all the same (dry run: not enforced)" if dry else "the agent got NXDOMAIN"))
            continue
        if rl == "revoked":                                                         # v1.28
            info(f"  {'REVOKED':11}  {str(r.get('action', '?')):13}  {r.get('resolved') or r.get('target', '')}")
            hint(f"{RULE_WORDS['revoked']}; the agent got {r.get('kernel_verdict', '?')}")
            continue
        if isinstance(line, int) and line >= 0:
            text = policy_line_text(policy, line) if policy else None
            where = f"policy line {line}" + (f": {text}" if text else
                                             " (that policy file is no longer on this host)")
        elif r.get("rule") in RULE_WORDS:
            where = RULE_WORDS[r["rule"]]
        else:
            where = r.get("rule", "no rule matched")
        target = r.get("resolved") or r.get("target", "")
        info(f"  {'WOULD_REFUSE' if dry else verdict_word(r):11}  {r.get('action', '?'):13}  {target}")
        ch = obo_text(r)                                                           # v1.28.1
        hint(f"{where}; " + ("let through (dry run: not enforced)" if dry else
                             f"{'sub-agent ' + ch if ch else 'the agent'} got {r.get('kernel_verdict', '?')}"))
    if s["refused"] > args.n:
        info(f"\n  ... and {s['refused'] - args.n} more (use -n to see them)")
    if ends:
        info(f"\n{len(ends)} connection(s) the proxy ended (inspecting mode):\n")
        for e in ends[: args.n]:
            why, cid = e.get("why"), e.get("proxy_conn")
            err = e.get("request_error") or e.get("tls_error") or ""
            label, what = {
                "refused_request": ("REFUSED", "the proxy refused the request before deciding it"
                                    f"{': ' + err if err else ''}; the agent got 403 Forbidden"),
                "server_tls": ("SERVER_TLS", "the server failed verification"
                               f"{': ' + err if err else ''}; nothing was sent, and the agent's handshake was refused"),
                "client_tls": ("CLIENT_TLS", f"the agent's TLS handshake failed{': ' + err if err else ''} "
                               "(does it trust the run's CA, and offer http/1.1?)"),
                "tls_timeout": ("TLS_TIMEOUT", "a handshake, or the first request's head, took over 10 s"),
                "max_body": ("MAX_BODY", f"{err or 'a body passed max_body'}; the connection was cut there"),
            }[why]
            info(f"  {label:11}  {'proxy_close':13}  connection {cid} "
                 f"({s['proxy_targets'].get(cid, '?')})")
            hint(what)
        if len(ends) > args.n:
            info(f"\n  ... and {len(ends) - args.n} more (use -n to see them)")
    cf = s["cred_refused"]
    if cf:                                                                          # v1.28
        info(f"\n{len(cf)} request(s) allowed with a credential, refused by the proxy (credential release):\n")
        for e in cf[: args.n]:
            cid = e.get("proxy_conn")
            target = s["proxy_targets"].get(cid, "?") if type(cid) is int else "?"
            info(f"  {'CREDENTIAL':11}  {'net.request':13}  connection {cid} "
                 f"({target}), request {e.get('request_seq', '?')}")
            hint(f"credential {e.get('credential', '?')}: {e.get('why', '?')}; nothing was sent to the server, "
                 f"and the agent got 403 Forbidden")
        if len(cf) > args.n:
            info(f"\n  ... and {len(cf) - args.n} more (use -n to see them)")
    info("\nUNSATISFIED: a deny rule matched.  UNKNOWN: no rule allowed it (refused by default).")
    if any(r.get("enforced") is False for r in s["refusals"][: args.n]):
        info("WOULD_REFUSE: the policy refuses it, but this was a dry run (varek run --dry-run): it was let "
             "through. `varek policy suggest` writes the rules that would allow it.")
    if cf:
        info("CREDENTIAL: the header the rule names must hold the credential's placeholder (VAREK_CRED_<NAME>), "
             "once, alone or after the rule's scheme.")
    if s["revoked"]:
        info("REVOKED: the run was revoked (varek revoke); calls after that are refused, whatever the policy says.")
    if any(r.get("event") == "dns_question" for r in s["refusals"][: args.n]):
        info("BUDGET: a wildcard rule's budget refused a new name (raise it with names= or rate=).")
    if any(r.get("rule") == "exec_not_in_ruleset" for r in s["refusals"][: args.n]):
        info("NOT_IN_SET: the policy allows the program's name, but only files present at startup can be launched.")
    if any(r.get("rule") == "exec_no_landlock" for r in s["refusals"][: args.n]):
        info("NO_LANDLOCK: launches need Landlock (Linux 5.13 or later, enabled); varek doctor says why it is missing.")
    if any(r.get("rule") == "exec_identity_mismatch" for r in s["refusals"][: args.n]):
        info("KILLED: a process ran a program the Warden did not decide to run; the audit fails such a run.")
    if any(r.get("rule") == "max_body" for r in s["refusals"][: args.n]):
        info("MAX_BODY: a rule allowed the request, but its body is over the rule's max_body.")
    return 0


def cmd_audit(args):
    cfg = config_or_defaults()
    log = latest_log(cfg, args.log)
    s = summarize(read_records(log))
    policy = _policy_for_log(cfg, s)
    if not policy:
        raise CliError("the policy file this run used is no longer on this host "
                       f"(SHA-256 {s.get('policy_sha')})",
                       fix="restore it, then audit with tools/varek_audit.py --policy <file>")
    argv = [sys.executable, tool("varek_audit.py"),
            "--policy", policy, "--checker", tool("vdp_cert_check")]
    pub = _pubkey(cfg)
    if pub:
        argv += ["--pubkey", pub]
    if cfg["anchor"] and os.path.isfile(cfg["anchor"]):
        argv += ["--anchor", cfg["anchor"]]
    if args.allow_incomplete:
        argv.append("--allow-incomplete")
    argv.append(log)
    return run_cmd(argv, check=False).returncode


def cmd_export_ocsf(args):
    """v1.31: `varek export --format ocsf`: OCSF 1.9.0 events (tools/varek_ocsf.py),
    audited first; --follow tails a live run; --verify checks events against
    their stream."""
    cfg = config_or_defaults()
    log = args.follow or latest_log(cfg, args.log)
    if args.follow and not os.path.exists(log):
        raise CliError(f"no stream at {log}", fix="give the path the run writes its verdict stream to")
    s = summarize(read_records(log)) if not args.follow else None
    policy = _policy_for_log(cfg, s) if s else (args.policy or cfg.get("policy"))
    if args.policy:
        policy = args.policy
    if not policy:
        raise CliError("the policy file this run used is not on this host",
                       fix="restore it, or give it with --policy; the events name the policy the run used")
    argv = [sys.executable, tool("varek_ocsf.py"), "--policy", policy, "--checker", tool("vdp_cert_check")]
    # review: the key given, else the configured one; the stream is audited
    # with it for --verify too
    pub = args.pubkey or _pubkey(cfg)
    if pub:
        argv += ["--pubkey", pub]
    if cfg["anchor"] and os.path.isfile(cfg["anchor"]):
        argv += ["--anchor", cfg["anchor"]]
    if args.verify:
        argv += ["--verify", args.verify, "--log", log]
    else:
        argv += ["--follow", log] if args.follow else ["--log", log]
        out = args.output or (None if args.follow else re.sub(r"\.log$", "", log) + ".ocsf.jsonl")
        if out:
            argv += ["--output", out]
        if args.follow and args.idle:
            argv += ["--idle", str(args.idle)]
    if args.allow_incomplete:
        argv.append("--allow-incomplete")
    rc = run_cmd(argv, check=False).returncode
    if rc == 0 and not args.verify and not args.follow:
        ok(f"OCSF 1.9.0 events written to {out}")
        hint(f"anyone can check them against the stream with `varek export --format ocsf --verify {out} {log}`")
    return rc


def cmd_export(args):
    if getattr(args, "format", "cyclonedx") == "ocsf":                  # v1.31
        return cmd_export_ocsf(args)
    if args.follow:
        raise CliError("--follow is for --format ocsf")
    if args.verify:
        cfg = load_config(required=False)
        pub = args.pubkey or (_pubkey(cfg) if cfg else None)
        if not pub:
            raise CliError("verifying needs the Warden's public key",
                           fix="pass --pubkey /etc/varek/log.key.pub")
        return run_cmd([sys.executable, tool("varek_cyclonedx.py"),
                        "--verify", args.verify, "--pubkey", pub], check=False).returncode
    cfg = config_or_defaults()
    log = latest_log(cfg, args.log)
    s = summarize(read_records(log))
    out = args.output or re.sub(r"\.log$", "", log) + ".cdx.json"
    policy = _policy_for_log(cfg, s)
    if not policy:
        raise CliError("the policy file this run used is no longer on this host "
                       f"(SHA-256 {s.get('policy_sha')})",
                       fix="restore it; the evidence must name the policy the run used")
    argv = [sys.executable, tool("varek_cyclonedx.py"), "--log", log,
            "--policy", policy, "--agent", args.agent, "--output", out]
    if not args.no_sign and cfg["sign_key"]:
        if not os.access(cfg["sign_key"], os.R_OK):
            raise CliError("signing the evidence needs the signing key, which only root can read",
                           fix="run `sudo varek export`, or `varek export --no-sign`")
        argv += ["--sign-key", cfg["sign_key"]]
    elif _pubkey(cfg):
        argv += ["--pubkey", _pubkey(cfg)]
    if args.allow_incomplete:
        argv.append("--allow-incomplete")
    rc = run_cmd(argv, check=False).returncode
    if rc == 0:
        ok(f"CycloneDX 1.6 authorization evidence written to {out}")
        if "--sign-key" in argv:
            hint(f"signed; anyone can check it with `varek export --verify {out}`")
    return rc


def cmd_bench_launch(args, cfg):
    """v1.27: `varek bench --launches`."""
    import varek_bench_launch       # only here: the rest of the command does not need it
    if args.policy or args.bare:
        raise CliError("--launches measures with the bench's own policies; --policy and --bare do not apply")
    args.n = 200 if args.n is None else args.n
    args.warmup = 20 if args.warmup is None else args.warmup
    args.rounds = 3 if args.rounds is None else args.rounds
    if args.n < 10 or args.rounds < 1 or args.warmup < 0:
        raise CliError("use -n of at least 10, --rounds of at least 1 and --warmup of 0 or more")
    run_as = args.run_as or (cfg["run_as"] if cfg else "nobody")
    sign_key = cfg["sign_key"] if cfg and cfg["sign_key"] and not args.no_sign else None
    if args.output and not os.access(os.path.dirname(os.path.abspath(args.output)), os.W_OK):
        raise CliError(f"cannot write {args.output}", fix="give -o a path in a writable directory")
    progress = (lambda m: None) if args.json else (
        lambda m: print(_paint("2", f"[varek] bench --launches {m}"), file=sys.stderr))
    try:
        res = varek_bench_launch.run(warden_bin(), tool("bench_workload"), tool("vdp_cert_check"),
                                     tool("varek_audit.py"), n=args.n, warmup=args.warmup, rounds=args.rounds,
                                     run_as=run_as, sign_key=sign_key, progress=progress, keep=args.keep)
    except varek_bench.BenchError as e:
        raise CliError(str(e), fix=e.fix)
    res["varek_command"] = CLI_VERSION
    if args.output:
        try:
            with open(args.output, "w") as fh:
                json.dump(res, fh, indent=2)
                fh.write("\n")
        except OSError as e:
            warn(f"could not write {args.output}: {e}")
    if args.json:
        print(json.dumps(res, indent=2))
    else:
        sys.stdout.write(varek_bench_launch.format_report(res, CLI_VERSION))
    return 0 if res["ok"] else 1


