# v1.28 step 4: revoking a running run, through the control socket the
# Warden opens for it (root's, /run/varek/<run>.ctl)
CTL_DIR = "/run/varek"
RUN_ID_RX = re.compile(r"^[0-9a-f]{32}$")


def revoke_one(run):
    """The Warden's answer, or None when no run by that id is running."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
    s.settimeout(30)
    try:
        s.connect(os.path.join(CTL_DIR, run + ".ctl"))
        s.send(b"revoke")
        return s.recv(256).decode("ascii", "replace") or "refused: no answer"
    except (FileNotFoundError, ConnectionRefusedError):
        return None
    except OSError as e:
        return f"refused: {e.strerror or e}"
    finally:
        s.close()


def cmd_revoke(args):
    need_root("revoke")
    if args.all:
        if args.run:
            raise CliError("give a run or --all, not both")
        try:
            runs = sorted(f[:-4] for f in os.listdir(CTL_DIR) if f.endswith(".ctl") and RUN_ID_RX.match(f[:-4]))
        except FileNotFoundError:
            runs = []
        if not runs:
            info("No run is running that can be revoked.")
            return 0
    elif not args.run:
        raise CliError("which run?", fix="`varek revoke <run>` (the Warden prints it at the start), "
                       "a verdict log, or `varek revoke --all`")
    else:
        run = args.run
        if os.path.isfile(run):
            first = next((r for r in read_records(run) if r.get("event") == "run_start"), {})
            run = first.get("run", "")
        if not RUN_ID_RX.match(run):
            raise CliError(f"not a run id: {args.run}", fix="a run id is 32 hex digits; the Warden prints it at the start")
        runs = [run]
    rc = 0
    for run in runs:
        ans = revoke_one(run)
        if ans is None and args.all:
            # v1.28 review: no Warden listens on it (it was killed): remove it
            try:
                os.unlink(os.path.join(CTL_DIR, run + ".ctl"))
                info(f"  {run}: has ended; removed the control socket it left behind")
            except OSError as e:
                info(f"  {run}: has ended (its control socket is left behind: {e.strerror})")
        elif ans is None:
            fail(f"{run}: no such run is running (it has ended, or never had a control socket)")
            rc = 1
        elif ans in ("revoked", "already revoked"):
            ok(f"{run}: {ans}")
        else:
            fail(f"{run}: {ans}")
            rc = 1
    return rc


def policy_line_text(path, n):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for i, line in enumerate(fh, 1):
                if i == n:
                    return line.split("#", 1)[0].strip()
    except OSError:
        pass
    return None


def policy_servers(path):
    """v1.31: the confined subjects the policy declares (MCP servers, and
    sub-agents marked confined), as the certificate checker reads them:
    [{k, name, mcp, line, sha, file}], and {policy line: k} for the rules
    written `for=` one."""
    q = run_cmd([tool("vdp_cert_check"), path, "identity"], capture=True)
    subs, forl = [], {}
    for ln in q.stdout.splitlines() if q.returncode == 0 else []:
        f = ln.split(" ")
        if len(f) == 6 and f[0] == "confined" and f[1].isdigit() and f[4].isdigit():
            t = (policy_line_text(path, int(f[4])) or "").split()
            fp = t[4] if t[:2] == ["mcp", "server"] and len(t) > 4 else t[2] if len(t) > 2 and t[1] == "exec" else "?"
            subs.append({"k": int(f[1]), "name": f[2], "mcp": f[3] == "mcp", "line": int(f[4]),
                         "sha": None if f[5] == "-" else f[5], "file": fp})
        elif len(f) == 3 and f[0] == "for" and f[1].isdigit() and f[2].isdigit():
            forl[int(f[1])] = int(f[2])
    return subs, forl


def check_server_files(path):
    """v1.31 (doctor): each confined subject's file: a regular file owned by
    root, writable by no group or other user, in directories no group or
    other user may write (unless sticky), and its sha256= pin. [(ok, text)]"""
    out = []
    for sv in policy_servers(path)[0]:
        f, what = sv["file"], f"{'MCP server' if sv['mcp'] else 'confined sub-agent'} {sv['name']} ({sv['file']})"
        try:
            st = os.stat(f)
        except OSError as e:
            out.append((False, f"{what}: {e.strerror}"))
            continue
        if not stat.S_ISREG(st.st_mode):
            out.append((False, f"{what}: not a regular file"))
            continue
        if st.st_uid != 0 or st.st_mode & 0o022:
            out.append((False, f"{what}: owned by uid {st.st_uid}, mode {stat.S_IMODE(st.st_mode):o}: anyone but "
                               f"root who can write it can replace the server"))
            continue
        # v1.31 review: the directories of the path as written (a symlink's own
        # directory) and of the file it reaches, each as it is (lstat)
        dirs, weak = [], None
        for start in (os.path.dirname(os.path.abspath(f)), os.path.dirname(os.path.realpath(f))):
            d = start
            while d and d not in dirs:
                dirs.append(d)
                d = "" if d == "/" else os.path.dirname(d)
        for d in dirs:
            try:
                ds = os.lstat(d)
            except OSError:
                weak = d
                break
            if stat.S_ISLNK(ds.st_mode):
                ds = os.stat(d)            # a link to a directory: the directory it names (its own is above)
            if ds.st_mode & 0o022 and not ds.st_mode & stat.S_ISVTX or ds.st_uid not in (0,):
                weak = d
                break
        if weak:
            out.append((False, f"{what}: {weak} is writable by others or not root's: the file can be replaced"))
            continue
        if sv["sha"]:
            with open(f, "rb") as fh:
                h = hashlib.sha256(fh.read()).hexdigest()
            out.append((h == sv["sha"], f"{what}: " + ("its SHA-256 is the pin" if h == sv["sha"] else
                                                      f"its SHA-256 {h} is not the pin {sv['sha']}: the run will not start")))
        else:
            out.append((True, f"{what}: owned by root, mode {stat.S_IMODE(st.st_mode):o} (not pinned: add sha256=)"))
    return out


