        raise CliError(f"cannot write {args.output}", fix="give -o a path in a writable directory")
    if SHOW_COMMANDS:
        print(_paint("2", f"$ {warden_bin()} <bench policy> --dns-server <bench> --run-as {run_as} -- "
                          f"python3 bench_proxy_client.py ...  (SNI and inspecting mode, and natively)"),
              file=sys.stderr)
    progress = (lambda m: None) if args.json else (
        lambda m: print(_paint("2", f"[varek] bench --proxy {m}"), file=sys.stderr))
    try:
        res = varek_bench_proxy.run(warden_bin(), tool("vdp_cert_check"), n=args.n, warmup=args.warmup,
                                    rounds=args.rounds, run_as=run_as, sign_key=sign_key,
                                    progress=progress, keep=args.keep)
    except varek_bench.BenchError as e:
        raise CliError(str(e), fix=e.fix)
    res["varek_command"] = CLI_VERSION
    budget_fail = []
    if args.max_added_p50 is not None:
        budget_fail = [f"{k} ({m})" for k, r in res["kinds"].items()
                       for m, v in r["added_p50_us"].items() if k != "denied" and v > args.max_added_p50]
        res["budget"] = {"max_added_p50_us": args.max_added_p50, "over": budget_fail}
    if args.output:
        try:
            with open(args.output, "w") as fh:
                json.dump(res, fh, indent=2)
                fh.write("\n")
        except OSError as e:
            warn(f"could not write {args.output}: {e}")
            args.output = None
    if args.json:
        print(json.dumps(res, indent=2))
    else:
        sys.stdout.write(varek_bench_proxy.format_report(res, CLI_VERSION))
        if budget_fail:
            fail(f"added p50 over {args.max_added_p50} us: " + ", ".join(budget_fail))
        if args.output:
            ok(f"results written to {args.output}")
        if res.get("kept"):
            info(f"  kept: the bench's files in {res['kept'][0]}; its policies and verdict "
                 f"streams in {res['kept'][1]}")
    return 0 if res["ok"] and not budget_fail else 1


