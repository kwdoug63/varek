EPILOG = """\
Getting started:
  sudo varek doctor                       is this host ready?
  sudo varek init --pack healthcare       settings, signing key, log directory
  sudo varek preflight --run              a real trial run, then its audit
  sudo varek run -- python3 agent.py      supervise an agent
  varek refusals                          what was refused in the last run, and why
  varek audit                             re-check the last run's verdicts and signatures
  sudo varek export                       signed CycloneDX 1.6 evidence for auditors
  sudo varek bench                        what mediation costs per call on this host

Add --show-commands to any command to print the underlying tool calls.
"""


def build_parser():
    p = argparse.ArgumentParser(
        prog="varek",
        description="Run AI agents under the VAREK Warden and check what it decided.",
        epilog=EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--show-commands", action="store_true",
                   help="print each underlying command before running it")
    sub = p.add_subparsers(dest="cmd", metavar="<command>")

    def add(name, fn, help_, **kw):
        sp = sub.add_parser(name, help=help_, description=help_, **kw)
        sp.set_defaults(fn=fn)
        return sp

    add("doctor", cmd_doctor, "check that this host can run the Warden")

    sp = add("init", cmd_init, "set up settings, signing key and log directory (root)")
    sp.add_argument("--pack", help="policy pack name (see `varek policy list`) or a policy file")
    sp.add_argument("--log-dir", help=f"where verdict streams go (default {DEFAULT_LOG_DIR})")
    sp.add_argument("--run-as", help="unprivileged user the agent runs as (default nobody)")
    sp.add_argument("--anchor", help="anchor path, e.g. /run/varek/anchor.fifo for an off-host anchor")
    sp.add_argument("--spool", help="the anchor forwarder's spool directory")
    sp.add_argument("--no-sign", action="store_true", help="do not create a signing key")
    sp.add_argument("--force", action="store_true", help="overwrite existing settings")
    sp.add_argument("--force-key", action="store_true", help="replace an existing signing key")

    pol = sub.add_parser("policy", help="list, inspect, check and switch policies",
                         description="List, inspect, check and switch policies.")
    psub = pol.add_subparsers(dest="pcmd", metavar="<action>")
    pol.set_defaults(fn=lambda a: (pol.print_help(), 0)[1])
    x = psub.add_parser("list", help="show the policy packs available")
    x.set_defaults(fn=cmd_policy_list)
    x = psub.add_parser("show", help="summarize a policy (default: the active one)")
    x.add_argument("file", nargs="?")
    x.set_defaults(fn=cmd_policy_show)
    x = psub.add_parser("check", help="lint a policy: rules that never fire, syntax errors")
    x.add_argument("file", nargs="?")
    x.add_argument("--explain", action="store_true",
                   help="also show, for each rule, an example it decides")
    x.set_defaults(fn=cmd_policy_check)
    x = psub.add_parser("use", help="make a pack or file the active policy (root)")
    x.add_argument("pack")
    x.set_defaults(fn=cmd_policy_use)
    x = psub.add_parser("add", help="install a licensed policy pack file (root)")
    x.add_argument("file")
    x.add_argument("--name", help="name to install it under")
    x.set_defaults(fn=cmd_policy_add)

    sp = add("preflight", cmd_preflight, "check the deployment before running agents")
    sp.add_argument("--run", action="store_true", help="also do a real trial run and audit it (root)")

    sp = add("run", cmd_run, "run an agent under the Warden (root)",
             usage="varek run [options] -- <agent command> [args...]")
    sp.add_argument("--policy", help="use this pack or file instead of the active policy")
    sp.add_argument("--plan", help="check this action-graph plan before the agent starts")
    sp.add_argument("--run-as", help="unprivileged user for the agent (default from settings)")
    sp.add_argument("--log", help="write the verdict stream here instead of a new file")
    sp.add_argument("--stderr-lines", type=int, default=20, metavar="N",
                    help="after the run, show the last N lines the agent wrote to stderr "
                         "(the Warden keeps them in the verdict stream; default 20)")
    sp.add_argument("command", nargs=argparse.REMAINDER)

    add("status", cmd_status, "show settings and the last run")

    sp = add("runs", cmd_runs, "list recent runs")
    sp.add_argument("-n", type=int, default=10, help="how many (default 10)")

    sp = add("refusals", cmd_refusals, "list the actions refused in a run, and why")
    sp.add_argument("log", nargs="?", help="a verdict log (default: the last run)")
    sp.add_argument("-n", type=int, default=25, help="how many to show (default 25)")

    sp = add("audit", cmd_audit, "re-check a run's certificates, chain and signatures")
    sp.add_argument("log", nargs="?", help="a verdict log (default: the last run)")
    sp.add_argument("--allow-incomplete", action="store_true",
                    help="audit a run that has no run_end yet")

    sp = add("export", cmd_export, "write CycloneDX 1.6 authorization evidence for a run")
    sp.add_argument("log", nargs="?", help="a verdict log (default: the last run)")
    sp.add_argument("-o", "--output", help="output file (default: next to the log, .cdx.json)")
    sp.add_argument("--agent", default="agent", help="name of the agent, for the evidence")
    sp.add_argument("--no-sign", action="store_true", help="do not sign the evidence")
    sp.add_argument("--allow-incomplete", action="store_true",
                    help="export a run that has no run_end yet")
    sp.add_argument("--verify", metavar="BOM", help="verify a signed evidence file instead")
    sp.add_argument("--pubkey", help="public key to verify with (default from settings)")

    sp = add("bench", cmd_bench, "measure what the Warden adds per call on this host (root)",
             epilog="Runs a fixed workload natively and under the Warden, alternating, and "
                    "reports per-call times, the time the Warden adds and its own decision "
                    "time, and checks every verdict. Uses the active policy's rules plus the "
                    "bench's own (or only the bench's own with --bare). Exit 1 if a check "
                    "fails or --max-added-p50 is exceeded.")
    sp.add_argument("--policy", help="measure with this pack or policy file's rules instead of the active policy")
    sp.add_argument("--bare", action="store_true", help="the bench's own rules only, no policy")
    sp.add_argument("-n", type=int, default=2000,
                    help="timed calls of each kind per run (default 2000)")
    sp.add_argument("--warmup", type=int, default=200, help="untimed calls of each kind first (default 200)")
    sp.add_argument("--rounds", type=int, default=5,
                    help="native and Warden runs, alternating (default 5 of each)")
    sp.add_argument("--run-as", help="user the workload runs as (default from settings, or nobody)")
    sp.add_argument("--no-sign", action="store_true", help="do not sign the bench's verdict streams")
    sp.add_argument("--max-added-p50", type=float, metavar="US",
                    help="exit 1 if any kind of call adds more than US microseconds at p50 (for CI)")
    sp.add_argument("-o", "--output", help="also write the full results as JSON to this file")
    sp.add_argument("--json", action="store_true", help="print the results as JSON instead of the report")
    sp.add_argument("--keep", action="store_true",
                    help="keep the bench's files, policy and verdict streams (printed at the end)")

    add("license", cmd_license, "check the VAREK Enterprise subscription (AWS Marketplace)")
    add("version", cmd_version, "show the varek command and Warden versions")
    return p


def main(argv=None):
    global SHOW_COMMANDS
    p = build_parser()
    args = p.parse_args(argv)
    SHOW_COMMANDS = args.show_commands
    if not getattr(args, "fn", None):
        p.print_help()
        return 0
    try:
        return args.fn(args) or 0
    except CliError as e:
        print(f"varek: {e}", file=sys.stderr)
        if e.fix:
            print(f"  fix: {e.fix}", file=sys.stderr)
        return e.code if isinstance(e.code, int) else 2
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
