# The sample's policy (VAREK v1.35): the banking agents may read accounts and
# convert currencies, and send no payment. The banking agent's plan is
# authorized under it; the payments agent's is refused: its toolkit allows
# every tool of its server, so the plan's step for its tools names none, which
# no rule here allows.
require warden 1.35
proxy inspect
allow path /usr/ readonly
allow path /lib/ readonly
allow path /lib64/ readonly
deny  path /etc/shadow
allow path /etc/ readonly
allow path /proc/self/ readonly
allow path exact /proc/stat readonly
allow path exact /proc/cpuinfo readonly
allow path exact /proc/meminfo readonly
allow path exact /proc/sys/crypto/fips_enabled readonly
allow path /sys/devices/system/cpu/ readonly
allow path /sys/fs/cgroup/ readonly
allow path exact /dev/null
allow path exact /dev/urandom readonly
allow path /tmp/
allow host us-south.ml.cloud.ibm.com:443
allow host banking.example.com:443
allow host fx.example.com:443
allow host payments.example.com:443
allow mcp https://banking.example.com/mcp initialize
allow mcp https://banking.example.com/mcp notifications/initialized
allow mcp https://banking.example.com/mcp tools/list
allow mcp https://banking.example.com/mcp tools/call get_*
allow mcp https://fx.example.com/mcp initialize
allow mcp https://fx.example.com/mcp notifications/initialized
allow mcp https://fx.example.com/mcp tools/list
allow mcp https://fx.example.com/mcp tools/call convert
allow mcp https://payments.example.com/mcp initialize
allow mcp https://payments.example.com/mcp notifications/initialized
allow mcp https://payments.example.com/mcp tools/list
allow mcp https://payments.example.com/mcp tools/call get_payment_status
