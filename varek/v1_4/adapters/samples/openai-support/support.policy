# The sample's policy (VAREK v1.35): the support agents may call OpenAI's API
# and search the help center. The triage agent's plan is authorized under it;
# the ops agent's is refused: its MCP server has no tool filter, so the plan's
# step for its tools names none, which no rule here allows.
require warden 1.35
proxy inspect
allow path /usr/ readonly
allow path /lib/ readonly
allow path /lib64/ readonly
deny  path /etc/shadow
allow path /etc/ readonly
allow path /proc/self/ readonly
allow path exact /dev/null
allow path exact /dev/urandom readonly
allow path /tmp/
allow path /srv/support/ readonly
allow host api.openai.com:443
allow host help.example.com:443
allow host ops.example.com:443
allow mcp https://help.example.com/mcp initialize
allow mcp https://help.example.com/mcp notifications/initialized
allow mcp https://help.example.com/mcp tools/list
allow mcp https://help.example.com/mcp tools/call search_articles
allow mcp https://help.example.com/mcp tools/call get_article
allow mcp https://ops.example.com/mcp initialize
allow mcp https://ops.example.com/mcp notifications/initialized
allow mcp https://ops.example.com/mcp tools/list
allow mcp https://ops.example.com/mcp tools/call read_*
