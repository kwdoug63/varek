# The sample's policy (VAREK v1.35): what the weather agent's runtime may do.
# The plan `varek plan generate --from agentcore` writes for the sample holds
# a run to the part of it the project gives this agent.
require warden 1.35
proxy inspect
allow path /usr/ readonly
allow path /lib/ readonly
allow path /lib64/ readonly
deny  path /etc/shadow
allow path /etc/ readonly
allow path /proc/self/ readonly
allow path exact /dev/null
allow path exact /dev/urandom readonly
allow path /tmp/
allow path /app/ readonly
allow path /mnt/session/
allow host bedrock-agentcore.us-east-1.amazonaws.com:443
allow host xray.us-east-1.amazonaws.com:443
allow host logs.us-east-1.amazonaws.com:443
allow host bedrock-runtime.us-east-1.amazonaws.com:443
allow host weather-tools-q1w2e3r4t5.gateway.bedrock-agentcore.us-east-1.amazonaws.com:443
allow mcp https://weather-tools-q1w2e3r4t5.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp initialize
allow mcp https://weather-tools-q1w2e3r4t5.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp notifications/initialized
allow mcp https://weather-tools-q1w2e3r4t5.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp tools/list
allow mcp https://weather-tools-q1w2e3r4t5.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp tools/call forecast___get_*
