# The sample's policy (VAREK v1.35): the travel agent may search flights
# through its gateway, not book them, and no other tool. The plan `varek plan
# generate --from agentcore` writes for the sample is refused under it: its
# gateway's hotels target lists its tools from the live server, so the plan's
# step for the gateway's tools names none, which no rule here allows.
require warden 1.35
proxy inspect
allow path /usr/ readonly
allow path /lib/ readonly
allow path /lib64/ readonly
deny  path /etc/shadow
allow path /etc/ readonly
allow path /proc/self/ readonly
allow path exact /dev/null
allow path exact /dev/urandom readonly
allow path /tmp/
allow path /var/task/ readonly
allow host xray.us-west-2.amazonaws.com:443
allow host logs.us-west-2.amazonaws.com:443
allow host travel-tools-z9x8c7v6b5.gateway.bedrock-agentcore.us-west-2.amazonaws.com:443
allow mcp https://travel-tools-z9x8c7v6b5.gateway.bedrock-agentcore.us-west-2.amazonaws.com/mcp initialize
allow mcp https://travel-tools-z9x8c7v6b5.gateway.bedrock-agentcore.us-west-2.amazonaws.com/mcp notifications/initialized
allow mcp https://travel-tools-z9x8c7v6b5.gateway.bedrock-agentcore.us-west-2.amazonaws.com/mcp tools/list
allow mcp https://travel-tools-z9x8c7v6b5.gateway.bedrock-agentcore.us-west-2.amazonaws.com/mcp tools/call flights___search_*
